object GrokSettingsForm: TGrokSettingsForm
  Left = 300
  Height = 260
  Top = 200
  Width = 480
  BorderStyle = bsDialog
  Caption = 'Grok Chat Settings'
  ClientHeight = 260
  ClientWidth = 480
  OnCloseQuery = FormCloseQuery
  OnCreate = FormCreate
  Position = poScreenCenter
  LCLVersion = '3.0'
  object FApiBaseLabel: TLabel
    Left = 16
    Height = 17
    Top = 16
    Width = 90
    Caption = 'API base URL:'
    ParentColor = False
  end
  object FApiBaseEdit: TEdit
    Left = 16
    Height = 28
    Top = 36
    Width = 448
    Anchors = [akTop, akLeft, akRight]
    TabOrder = 0
    Text = 'https://api.x.ai/v1'
  end
  object FApiKeyLabel: TLabel
    Left = 16
    Height = 17
    Top = 76
    Width = 54
    Caption = 'API key:'
    ParentColor = False
  end
  object FApiKeyEdit: TEdit
    Left = 16
    Height = 28
    Top = 96
    Width = 448
    Anchors = [akTop, akLeft, akRight]
    EchoMode = emPassword
    PasswordChar = '*'
    TabOrder = 1
  end
  object FModelLabel: TLabel
    Left = 16
    Height = 17
    Top = 136
    Width = 42
    Caption = 'Model:'
    ParentColor = False
  end
  object FModelEdit: TEdit
    Left = 16
    Height = 28
    Top = 156
    Width = 448
    Anchors = [akTop, akLeft, akRight]
    TabOrder = 2
    Text = 'grok-4'
  end
  object FHintLabel: TLabel
    Left = 16
    Height = 17
    Top = 196
    Width = 448
    Anchors = [akTop, akLeft, akRight]
    Caption = 'Stored in the IDE config directory (LazGrokChat.xml).'
    Font.Color = clGrayText
    ParentColor = False
    ParentFont = False
  end
  object FButtonPanel: TButtonPanel
    Left = 6
    Height = 34
    Top = 220
    Width = 468
    OKButton.Name = 'OKButton'
    OKButton.DefaultCaption = True
    HelpButton.Name = 'HelpButton'
    HelpButton.DefaultCaption = True
    CloseButton.Name = 'CloseButton'
    CloseButton.DefaultCaption = True
    CancelButton.Name = 'CancelButton'
    CancelButton.DefaultCaption = True
    TabOrder = 3
    ShowButtons = [pbOK, pbCancel]
  end
end
