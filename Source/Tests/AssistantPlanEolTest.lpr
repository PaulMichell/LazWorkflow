Program AssistantPlanEolTest;

{ Plan writes keep an existing file's line ending. A line-feed snippet must still match a CRLF plan.
  (c) 2026 Michell Computing. }

{$IFDEF FPC}
  {$MODE OBJFPC}
  {$LONGSTRINGS ON}
{$ENDIF}

Uses
  {$IFDEF UNIX}
  cthreads,
  {$ENDIF}
  Classes, SysUtils, FileUtil, AssistantPlan, AssistantWorkTarget;

Var
  FailCount: Integer;
  Root, SelectErr: String;

Procedure Check(Const Title: String; Condition: Boolean);
Begin
  If Condition Then
    WriteLn('ok   ', Title)
  Else
    Begin
      WriteLn('FAIL ', Title);
      Inc(FailCount);
    End;
End;

Function MakeTempRoot: String;
Begin
  Result := IncludeTrailingPathDelimiter(GetTempDir) + 'laz-plan-eol-' + FormatDateTime('hhnnsszzz', Now);
  ForceDirectories(ExcludeTrailingPathDelimiter(Result));
End;

Function PlanBody(Const Eol, Status: String): String;
Begin
  Result :=
    '# Endings' + Eol +
    Eol +
    'Generated by Lazarus Project Assistant.' + Eol +
    Eol +
    '## 1. Keep endings' + Eol +
    Eol +
    'Keep this paragraph.' + Eol +
    Eol +
    '### 1.1 Status line' + Eol +
    'Status: ' + Status + Eol +
    Eol +
    'Leave this line alone.' + Eol;
End;

Procedure WriteRaw(Const Path, Body: String);
Var
  Stream: TFileStream;
Begin
  ForceDirectories(ExtractFilePath(Path));
  Stream := TFileStream.Create(Path, fmCreate);
  Try
    If Length(Body) > 0 Then
      Stream.WriteBuffer(Body[1], Length(Body));
  Finally
    Stream.Free;
  End;
End;

Function ReadRaw(Const Path: String): String;
Var
  Stream: TFileStream;
Begin
  Result := '';
  Stream := TFileStream.Create(Path, fmOpenRead Or fmShareDenyWrite);
  Try
    SetLength(Result, Stream.Size);
    If Length(Result) > 0 Then
      Stream.ReadBuffer(Result[1], Length(Result));
  Finally
    Stream.Free;
  End;
End;

Function HasBareLineFeed(Const Body: String): Boolean;
Var
  I: Integer;
Begin
  Result := False;
  For I := 1 To Length(Body) Do
    If (Body[I] = #10) And ((I = 1) Or (Body[I - 1] <> #13)) Then
      Exit(True);
End;

Procedure TestReplaceKeepsCrlf(Const Root: String);
Var
  Path, Resolved, Err, Raw: String;
  ReplaceCount: Integer;
Begin
  Path := IncludeTrailingPathDelimiter(Root) + 'Documents' + PathDelim + 'Plan.md';
  WriteRaw(Path, PlanBody(#13#10, 'not started'));
  Check('line-feed snippet replaces the status', ReplaceInMarkdownFile('Documents/Plan.md',
    'Status: not started' + #10 + #10 + 'Leave this line alone.',
    'Status: in progress' + #10 + #10 + 'Leave this line alone.',
    False, False, Resolved, Err, ReplaceCount) And (ReplaceCount = 1));
  If Err <> '' Then
    WriteLn(Err);
  Raw := ReadRaw(Path);
  Check('only the status text changed', Raw = PlanBody(#13#10, 'in progress'));
  Check('other lines still end in CRLF', (Pos(#13#10, Raw) > 0) And (Not HasBareLineFeed(Raw)));
End;

Procedure TestStatusKeepsCrlf(Const Root: String);
Var
  Path, Err, Raw: String;
Begin
  Path := IncludeTrailingPathDelimiter(Root) + 'Documents' + PathDelim + 'Status.md';
  WriteRaw(Path, PlanBody(#13#10, 'not started'));
  Check('status change returns', SetPlanSectionStatus('Documents/Status.md', 1, pssInProgress, Err));
  If Err <> '' Then
    WriteLn(Err);
  Raw := ReadRaw(Path);
  Check('status change changes only the status', Raw = PlanBody(#13#10, 'in progress'));
  Check('status change keeps CRLF', (Pos(#13#10, Raw) > 0) And (Not HasBareLineFeed(Raw)));
End;

Procedure TestWriteKeepsExistingEnding(Const Root: String);
Var
  Path, Resolved, Err, Raw: String;
Begin
  Path := IncludeTrailingPathDelimiter(Root) + 'Documents' + PathDelim + 'Rewrite.md';
  WriteRaw(Path, PlanBody(#13#10, 'not started'));
  Check('rewrite of a CRLF plan returns', WriteMarkdownFile('Documents/Rewrite.md', PlanBody(#10, 'in progress'),
    False, Resolved, Err));
  If Err <> '' Then
    WriteLn(Err);
  Raw := ReadRaw(Path);
  Check('rewrite keeps CRLF', Raw = PlanBody(#13#10, 'in progress'));
  Check('new plan uses LF', WriteMarkdownFile('Documents/New.md', PlanBody(#13#10, 'not started'), False, Resolved, Err));
  If Err <> '' Then
    WriteLn(Err);
  Raw := ReadRaw(IncludeTrailingPathDelimiter(Root) + 'Documents' + PathDelim + 'New.md');
  Check('new plan has no CR', (Raw = PlanBody(#10, 'not started')) And (Pos(#13, Raw) = 0));
End;

Begin
  FailCount := 0;
  Root := MakeTempRoot;
  Try
    Check('select the temporary folder', AssistantTarget.SelectFolder(Root, SelectErr));
    If SelectErr <> '' Then
      WriteLn(SelectErr);
    TestReplaceKeepsCrlf(Root);
    TestStatusKeepsCrlf(Root);
    TestWriteKeepsExistingEnding(Root);
  Finally
    DeleteDirectory(ExcludeTrailingPathDelimiter(Root), False);
  End;
  WriteLn(FailCount, ' failure(s).');
  If FailCount <> 0 Then
    Halt(1);
End.
