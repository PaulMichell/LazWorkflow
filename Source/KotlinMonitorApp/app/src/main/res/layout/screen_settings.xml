<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical" >
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">
    <ImageButton
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:id="@+id/back"
      android:minWidth="48dp"
      android:minHeight="48dp"
      android:src="@drawable/ic_back"
      android:contentDescription="@string/monitor_back"/>
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:id="@+id/heading"
      android:text="@string/monitor_settings"
      android:textSize="22sp"/>
  </LinearLayout>
  <ScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="true">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="16dp">
      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/linkStatus"
        android:text="@string/monitor_not_connected" />
      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/connectionHeading"
        android:text="@string/monitor_connection"
        android:textSize="18sp"/>
      <EditText
        android:importantForAutofill="no"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/address"
        android:hint="@string/monitor_host_address"
        android:inputType="textUri"
        android:singleLine="true"/>
      <EditText
        android:importantForAutofill="no"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/port"
        android:hint="@string/monitor_port"
        android:inputType="number"
        android:singleLine="true"/>
      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/endpointHint"
        android:text="@string/endpoint_hint" />
      <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/connect"
        android:text="@string/monitor_connect"/>
      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/error"
        android:text=""
        android:textColor="@color/monitor_error"/>
      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/savedHostsHeading"
        android:text="@string/monitor_saved_hosts"
        android:textSize="18sp"/>
      <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/addHost"
        android:text="@string/monitor_add_host"/>
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/savedHostRows"
        android:orientation="vertical"/>
      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/viewHeading"
        android:text="@string/monitor_view"
        android:textSize="18sp"/>
      <Switch
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/showThinking"
        android:text="@string/monitor_show_thinking"
        android:minHeight="56dp"/>
      <Switch
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/showTools"
        android:text="@string/monitor_show_tool_calls"
        android:minHeight="56dp"/>
      <TextView
        android:id="@+id/dictationHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/monitor_dictation"
        android:textSize="18sp"/>
      <TextView
        android:id="@+id/dictationLanguageLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:labelFor="@+id/dictationLanguage"
        android:text="@string/monitor_dictation_language"/>
      <Spinner
        android:id="@+id/dictationLanguage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"/>
      <TextView
        android:id="@+id/dictationLanguageNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/monitor_error"
        android:visibility="gone"/>
      <TextView
        android:id="@+id/snippetsHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/monitor_snippets"
        android:textSize="18sp"/>
      <EditText
        android:id="@+id/snippetText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/monitor_snippet"
        android:importantForAutofill="no"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLength="500"
        android:maxLines="4"/>
      <Button
        android:id="@+id/addSnippet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/monitor_add_snippet"/>
      <LinearLayout
        android:id="@+id/snippetRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"/>
      <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/helpToggle"
        android:text="@string/monitor_connection_help"
        android:drawableEnd="@drawable/ic_expand"/>
      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/help"
        android:text=""
        android:visibility="gone"/>
    </LinearLayout>
  </ScrollView>
</LinearLayout>
