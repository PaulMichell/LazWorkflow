<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/shell"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical">
  <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1">
    <include
      android:id="@+id/conversation"
      layout="@layout/screen_conversation"/>
    <include
      android:id="@+id/plan"
      layout="@layout/screen_plan"
      android:visibility="gone"/>
    <include
      android:id="@+id/tasks"
      layout="@layout/screen_tasks"
      android:visibility="gone"/>
    <include
      android:id="@+id/settings"
      layout="@layout/screen_settings"
      android:visibility="gone"/>
  </FrameLayout>
  <LinearLayout
    android:id="@+id/statusBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">
    <TextView
      android:id="@+id/status"
      android:layout_width="0dp"
      android:layout_weight="1"
      android:layout_height="wrap_content"
      android:textSize="12sp"/>
    <TextView
      android:id="@+id/activityStatus"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:maxWidth="180dp"
      android:gravity="end"
      android:textSize="12sp"/>
  </LinearLayout>
  <LinearLayout
    android:id="@+id/navigation"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center">
    <Button
        style="?android:attr/buttonBarButtonStyle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:id="@+id/conversationTab"
      android:text="@string/monitor_conversation"/>
    <Button
        style="?android:attr/buttonBarButtonStyle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:id="@+id/planTab"
      android:text="@string/monitor_plan"/>
    <Button
        style="?android:attr/buttonBarButtonStyle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:id="@+id/tasksTab"
      android:text="@string/monitor_tasks"/>
  </LinearLayout>
</LinearLayout>
