<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="12dp">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/monitor_mode"/>
    <Spinner
      android:id="@+id/mode"
      android:layout_width="0dp"
      android:layout_weight="1"
      android:layout_height="48dp"/>
    <Button
      style="?android:attr/buttonBarButtonStyle"
      android:id="@+id/search"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/monitor_search"/>
    <ImageButton
      android:id="@+id/settingsButton"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:src="@drawable/ic_menu"
      android:contentDescription="@string/monitor_settings"/>
  </LinearLayout>
  <LinearLayout
    android:id="@+id/searchBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical">
      <EditText
        android:id="@+id/searchQuery"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:hint="@string/monitor_search_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:singleLine="true"/>
      <Button
        style="?android:attr/buttonBarButtonStyle"
        android:id="@+id/searchPrevious"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/monitor_search_previous"/>
      <Button
        style="?android:attr/buttonBarButtonStyle"
        android:id="@+id/searchNext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/monitor_search_next"/>
    </LinearLayout>
    <TextView
      android:id="@+id/searchMiss"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:textSize="12sp"
      android:visibility="gone"/>
  </LinearLayout>
  <TextView
    android:id="@+id/sessionFirst"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:textSize="12sp"
    android:visibility="gone"/>
  <TextView
    android:id="@+id/sessionSecond"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:textSize="12sp"
    android:visibility="gone"/>
  <TextView
    android:id="@+id/sessionContext"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:textSize="12sp"
    android:visibility="gone"/>
  <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1">
    <ListView
      android:id="@+id/transcript"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:divider="@android:color/transparent"
      android:dividerHeight="8dp"
      android:fastScrollEnabled="true"
      android:fastScrollAlwaysVisible="true"
      android:transcriptMode="normal"/>
    <Button
      android:id="@+id/latest"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="bottom|center_horizontal"
      android:layout_marginBottom="8dp"
      android:elevation="4dp"
      android:focusable="false"
      android:focusableInTouchMode="false"
      android:contentDescription="@string/monitor_latest"
      android:text="@string/monitor_latest"
      android:visibility="gone"/>
  </FrameLayout>
  <computing.michell.monitor.ui.PromptEditText
    android:id="@+id/prompt"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:hint="@string/monitor_prompt"
    android:inputType="textCapSentences|textMultiLine"
    android:maxLines="5"
    android:gravity="top"/>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">
    <ImageButton
      android:id="@+id/dictate"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:src="@drawable/ic_dictate"
      android:contentDescription="@string/monitor_dictate_prompt"/>
    <Button
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:id="@+id/send"
      android:text="@string/monitor_send"/>
    <Button
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:id="@+id/stop"
      android:text="@string/monitor_stop"/>
    <Button
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:id="@+id/newConversation"
      android:text="@string/monitor_new"/>
    <Button
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:id="@+id/refresh"
      android:text="@string/monitor_refresh"/>
    <Button
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:id="@+id/speak"
      android:text="@string/monitor_speak"/>
    <Button
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:id="@+id/share"
      android:text="@string/monitor_share"/>
  </LinearLayout>
</LinearLayout>
