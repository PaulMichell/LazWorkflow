object GitInitForm: TGitInitForm
  Left = 300
  Height = 140
  Top = 200
  Width = 520
  BorderStyle = bsDialog
  Caption = 'Initialise Repository'
  ClientHeight = 140
  ClientWidth = 520
  OnCloseQuery = FormCloseQuery
  OnCreate = FormCreate
  Position = poScreenCenter
  LCLVersion = '3.0'
  object FolderLabel: TLabel
    Left = 16
    Height = 17
    Top = 16
    Width = 152
    Caption = 'Project folder (Git root):'
    ParentColor = False
  end
  object FolderEdit: TDirectoryEdit
    Left = 16
    Height = 28
    Top = 40
    Width = 480
    ShowHidden = False
    ButtonWidth = 23
    DialogTitle = 'Select folder for the new Git repository'
    NumGlyphs = 1
    MaxLength = 0
    TabOrder = 0
  end
  object ButtonPanel: TButtonPanel
    Left = 6
    Height = 34
    Top = 100
    Width = 508
    OKButton.Name = 'OKButton'
    OKButton.DefaultCaption = True
    HelpButton.Name = 'HelpButton'
    HelpButton.DefaultCaption = True
    CloseButton.Name = 'CloseButton'
    CloseButton.DefaultCaption = True
    CancelButton.Name = 'CancelButton'
    CancelButton.DefaultCaption = True
    TabOrder = 1
    ShowButtons = [pbOK, pbCancel]
  end
end
