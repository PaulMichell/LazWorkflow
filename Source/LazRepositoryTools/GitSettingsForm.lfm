      ClientWidth = 492
      TabOrder = 0
      object RepoPathLabel: TLabel
        Left = 12
        Height = 18
        Top = 8
        Width = 468
        Anchors = [akTop, akLeft, akRight]
        Caption = 'No repository selected'
