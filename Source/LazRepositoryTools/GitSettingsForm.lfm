      ClientHeight = 141
      ClientWidth = 492
      TabOrder = 2
      object AutoRefreshCheck: TCheckBox
        Left = 12
        Height = 22
        Top = 8
        Width = 460
        Anchors = [akTop, akLeft, akRight]
