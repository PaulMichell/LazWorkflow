        Top = 35
        Width = 360
        Anchors = [akTop, akLeft, akRight]
        TabOrder = 0
      end
      object UserEmailLabel: TLabel
        Left = 12
        Height = 18
        Top = 79
        Width = 69
        Caption = 'User email:'
        ParentColor = False
      end
      object UserEmailEdit: TEdit
        Left = 120
        Height = 32
        Top = 75
        Width = 360
        Anchors = [akTop, akLeft, akRight]
        TabOrder = 1
      end
    end
    object DescriptionGroup: TGroupBox
      Left = 12
      Height = 120
      Top = 165
      Width = 496
      Anchors = [akTop, akLeft, akRight]
      Caption = 'Repository description (.git/description)'
      ClientHeight = 93
      ClientWidth = 492
      TabOrder = 1
