        Left = 12
        Height = 69
        Top = 8
        Width = 468
        Anchors = [akTop, akLeft, akRight, akBottom]
        ScrollBars = ssAutoVertical
        TabOrder = 0
      end
    end
    object AppGroup: TGroupBox
      Left = 12
      Height = 168
      Top = 295
      Width = 496
      Anchors = [akTop, akLeft, akRight]
