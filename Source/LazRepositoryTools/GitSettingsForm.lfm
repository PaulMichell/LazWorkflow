      end
      object UserEmailEdit: TEdit
        Left = 120
        Height = 32
        Top = 75
        Width = 360
        Anchors = [akTop, akLeft, akRight]
        TabOrder = 1
      end
    end
    object DescriptionGroup: TGroupBox
      Left = 12
      Height = 120
      Top = 165
