object GitSettingsForm: TGitSettingsForm
  Left = 280
  Height = 520
  Top = 160
  Width = 520
  BorderStyle = bsDialog
  Caption = 'Repository Settings'
  ClientHeight = 520
  ClientWidth = 520
  OnCloseQuery = FormCloseQuery
  OnCreate = FormCreate
  Position = poScreenCenter
  LCLVersion = '3.0'
  object FScrollBox: TScrollBox
    Left = 0
    Height = 472
    Top = 0
    Width = 520
    HorzScrollBar.Page = 1
    VertScrollBar.Page = 1
    Align = alClient
    BorderStyle = bsNone
    ClientHeight = 472
    ClientWidth = 520
    TabOrder = 0
    object FAppGroup: TGroupBox
      Left = 12
      Height = 100
      Top = 12
      Width = 496
      Anchors = [akTop, akLeft, akRight]
      Caption = 'Manage Repository window'
      ClientHeight = 76
      ClientWidth = 492
      TabOrder = 0
      object FAutoRefreshCheck: TCheckBox
        Left = 12
        Height = 23
        Top = 8
        Width = 460
        Anchors = [akTop, akLeft, akRight]
        Caption = 'Automatically refresh repository state'
        TabOrder = 0
        OnChange = AutoRefreshCheckChange
      end
      object FIntervalLabel: TLabel
        Left = 32
        Height = 17
        Top = 42
        Width = 97
        Caption = 'Refresh interval:'
        ParentColor = False
      end
      object FIntervalSpin: TSpinEdit
        Left = 140
        Height = 28
        Top = 38
        Width = 80
        MaxValue = 3600
        MinValue = 2
        TabOrder = 1
        Value = 5
      end
      object FSecondsLabel: TLabel
        Left = 230
        Height = 17
        Top = 42
        Width = 48
        Caption = 'seconds'
        ParentColor = False
      end
    end
    object FIdentityGroup: TGroupBox
      Left = 12
      Height = 200
      Top = 124
      Width = 496
      Anchors = [akTop, akLeft, akRight]
      Caption = 'Repository identity (local .git/config)'
      ClientHeight = 176
      ClientWidth = 492
      TabOrder = 1
      object FRepoPathLabel: TLabel
        Left = 12
        Height = 34
        Top = 8
        Width = 468
        Anchors = [akTop, akLeft, akRight]
        Caption = 'No repository selected'
        ParentColor = False
        WordWrap = True
      end
      object FUserNameLabel: TLabel
        Left = 12
        Height = 17
        Top = 52
        Width = 70
        Caption = 'User name:'
        ParentColor = False
      end
      object FUserNameEdit: TEdit
        Left = 120
        Height = 28
        Top = 48
        Width = 360
        Anchors = [akTop, akLeft, akRight]
        TabOrder = 0
      end
      object FUserEmailLabel: TLabel
        Left = 12
        Height = 17
        Top = 92
        Width = 68
        Caption = 'User email:'
        ParentColor = False
      end
      object FUserEmailEdit: TEdit
        Left = 120
        Height = 28
        Top = 88
        Width = 360
        Anchors = [akTop, akLeft, akRight]
        TabOrder = 1
      end
      object FGlobalHintLabel: TLabel
        Left = 12
        Height = 40
        Top = 128
        Width = 468
        Anchors = [akTop, akLeft, akRight]
        Caption = 'Saved to this repository only (git config --local). Leave blank to remove the local override.'
        Font.Color = clGrayText
        ParentColor = False
        ParentFont = False
        WordWrap = True
      end
    end
    object FDescriptionGroup: TGroupBox
      Left = 12
      Height = 120
      Top = 336
      Width = 496
      Anchors = [akTop, akLeft, akRight]
      Caption = 'Repository description (.git/description)'
      ClientHeight = 96
      ClientWidth = 492
      TabOrder = 2
      object FDescriptionMemo: TMemo
        Left = 12
        Height = 72
        Top = 8
        Width = 468
        Anchors = [akTop, akLeft, akRight, akBottom]
        ScrollBars = ssAutoVertical
        TabOrder = 0
      end
    end
  end
  object FButtonPanel: TButtonPanel
    Left = 6
    Height = 34
    Top = 480
    Width = 508
    OKButton.Name = 'OKButton'
    OKButton.DefaultCaption = True
    HelpButton.Name = 'HelpButton'
    HelpButton.DefaultCaption = True
    CloseButton.Name = 'CloseButton'
    CloseButton.DefaultCaption = True
    CancelButton.Name = 'CancelButton'
    CancelButton.DefaultCaption = True
    TabOrder = 1
    ShowButtons = [pbOK, pbCancel]
  end
end
