object GitGraphForm: TGitGraphForm
  Left = 200
  Height = 600
  Top = 100
  Width = 900
  Caption = 'Manage Repository'
  ClientHeight = 600
  ClientWidth = 900
  KeyPreview = True
  OnCreate = FormCreate
  OnDestroy = FormDestroy
  OnKeyDown = FormKeyDown
  OnShow = FormShow
  Position = poDefaultPosOnly
  LCLVersion = '3.0'
  object FActionList: TActionList
    Left = 40
    Top = 40
    object FPushAction: TAction
      Caption = 'Push'
      OnExecute = PushActionExecute
    end
    object FPullAction: TAction
      Caption = 'Pull'
      OnExecute = PullActionExecute
    end
    object FFetchAction: TAction
      Caption = 'Fetch'
      OnExecute = FetchActionExecute
    end
    object FRemotesAction: TAction
      Caption = 'Remotes…'
      OnExecute = RemotesActionExecute
    end
  end
  object FPopup: TPopupMenu
    Left = 100
    Top = 40
