      Caption = 'Show commit'
      OnClick = PopupShowCommit
    end
    object FMiCopySha: TMenuItem
      Caption = 'Copy SHA'
      OnClick = PopupCopySha
    end
    object FMiSep: TMenuItem
      Caption = '-'
    end
    object FMiCheckout: TMenuItem
      Caption = 'Checkout…'
      OnClick = PopupCheckout
    end
    object FMiCreateBranch: TMenuItem
      Caption = 'Create branch here…'
      OnClick = PopupCreateBranch
    end
  end
