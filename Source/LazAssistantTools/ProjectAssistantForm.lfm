  object ActionList: TActionList
    Left = 40
    Top = 40
    object NewChatAction: TAction
      Caption = 'New Chat'
      OnExecute = NewChatActionExecute
    end
    object NewPlanAction: TAction
      Caption = 'New Plan'
      Hint = 'Create a plan and switch to Plan mode'
      OnExecute = NewPlanActionExecute
    end
    object RunPlanAction: TAction
      Caption = 'Run Plan'
      Hint = 'Switch to Build and work through incomplete packages until done, error, or context limit'
      OnExecute = RunPlanActionExecute
    end
    object AttachImageAction: TAction
      Caption = 'Attach Image'
      Hint = 'Attach an image to the next message'
      OnExecute = AttachImageActionExecute
    end
    object RemoveAttachmentAction: TAction
      Tag = -1
      Caption = 'Remove'
      Enabled = False
      Hint = 'Remove this image from the next message'
      OnExecute = RemoveAttachmentActionExecute
    end
    object SaveAttachmentAction: TAction
      Tag = -1
      Caption = 'Save'
      Enabled = False
      Hint = 'Save this image'
      OnExecute = SaveAttachmentActionExecute
    end
    object PreviewAttachmentAction: TAction
      Tag = -1
      Caption = 'Preview'
      Enabled = False
      Hint = 'Preview this image'
      OnExecute = PreviewAttachmentActionExecute
    end
    object SendAction: TAction
      Caption = 'Send'
      OnExecute = SendActionExecute
    end
    object StopAction: TAction
      Caption = 'Stop'
      Enabled = False
      OnExecute = StopActionExecute
    end
    object ReviewCompileAction: TAction
      Caption = 'Review Compile'
      OnExecute = ReviewCompileActionExecute
    end
    object ReviewBuildAction: TAction
      Caption = 'Review Build'
      OnExecute = ReviewBuildActionExecute
    end
    object ReviewChangesAction: TAction
      Caption = 'Review Changes'
      Hint = 'Fan out Pascal naming, structure, and review lenses over changed files'
      OnExecute = ReviewChangesActionExecute
    end
    object FixErrorAction: TAction
      Caption = 'Fix Error'
      Hint = 'Fix the selected Messages line in Build mode (tools apply the edit)'
      OnExecute = FixErrorActionExecute
    end
    object SettingsAction: TAction
      Caption = 'Settings…'
      OnExecute = SettingsActionExecute
    end
    object ToggleToolUseAction: TAction
      Caption = 'Hide Tool Use'
      OnExecute = ToggleToolUseActionExecute
    end
    object ToggleThinkingAction: TAction
      Caption = 'Show Thinking'
      OnExecute = ToggleThinkingActionExecute
    end
    object ExportHistoryAction: TAction
      Caption = 'Export…'
      OnExecute = ExportHistoryActionExecute
    end
    object DeleteHistoryAction: TAction
      Caption = 'Delete…'
      OnExecute = DeleteHistoryActionExecute
    end
    object CommandsAction: TAction
      Caption = 'Commands…'
      Hint = 'Command catalog (Ctrl+P). Type / in the prompt to search.'
      OnExecute = CommandsActionExecute
    end
    object ContextBreakdownAction: TAction
      Caption = 'Context Breakdown'
      Hint = 'Token estimate for the next request'
      OnExecute = ContextBreakdownActionExecute
    end
    object SessionInfoAction: TAction
      Caption = 'Session Info'
      Hint = 'Mode, model, plan, and conversation'
      OnExecute = SessionInfoActionExecute
    end
    object ModelPickerAction: TAction
      Caption = 'Model…'
      Hint = 'Choose model, thinking level, and approval'
      OnExecute = ModelPickerActionExecute
    end
    object ThinkingPickerAction: TAction
      Caption = 'Thinking Level…'
      Hint = 'Reasoning effort for the next turn'
      OnExecute = ThinkingPickerActionExecute
    end
    object SkillsPickerAction: TAction
      Caption = 'Skills…'
      Hint = 'Pin a skill for the session'
      OnExecute = SkillsPickerActionExecute
    end
    object CompactContextAction: TAction
      Caption = 'Compact Context'
      Hint = 'Shrink older turns to free context'
      OnExecute = CompactContextActionExecute
    end
    object CopyLastAnswerAction: TAction
      Caption = 'Copy Last Answer'
      Hint = 'Copy the current answer to the clipboard'
      OnExecute = CopyLastAnswerActionExecute
    end
    object OpenPlanAction: TAction
      Caption = 'Open Active Plan'
      Hint = 'Open the active plan Markdown'
      OnExecute = OpenPlanActionExecute
    end
    object OpenPlanSheetAction: TAction
      Caption = 'Open'
      Hint = 'Open the active plan in the Markdown viewer'
      OnExecute = OpenPlanActionExecute
    end
    object RemovePlanAction: TAction
      Caption = 'Remove'
      Hint = 'Remove this plan from the available list. The file is kept.'
      OnExecute = RemovePlanActionExecute
    end
    object BuildThisAction: TAction
      Caption = 'Build This'
      Hint = 'Switch to Build and seed the next incomplete package'
      OnExecute = BuildThisActionExecute
    end
    object RevisePlanAction: TAction
      Caption = 'Revise'
      Hint = 'Stay in Plan and edit the prompt'
      OnExecute = RevisePlanActionExecute
    end
    object ChatModeAction: TAction
      Caption = 'Chat Mode'
      Hint = 'General chat, no project tools'
      OnExecute = ChatModeActionExecute
    end
    object InspectModeAction: TAction
      Caption = 'Inspect Mode'
      Hint = 'Read-only Q&A'
      OnExecute = InspectModeActionExecute
    end
    object PlanModeAction: TAction
      Caption = 'Plan Mode'
      Hint = 'Write the plan file'
      OnExecute = PlanModeActionExecute
    end
    object BuildModeAction: TAction
      Caption = 'Build Mode'
      Hint = 'Edit sources and compile'
      OnExecute = BuildModeActionExecute
    end
  end
