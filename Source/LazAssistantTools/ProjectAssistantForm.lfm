  object ActionList: TActionList
    Left = 55
    Top = 110
    object NewConversationAction: TAction
      Caption = 'New'
      OnExecute = NewConversationActionExecute
    end
    object NewPlanAction: TAction
      Caption = 'New Plan'
      Hint = 'Create a plan and switch to Plan mode'
      OnExecute = NewPlanActionExecute
    end
    object RunPlanAction: TAction
      Caption = 'Run Plan'
      Hint = 'Switch to Build and work through incomplete packages until done, error, or context limit'
      OnExecute = RunPlanActionExecute
    end
    object AttachImageAction: TAction
      Caption = 'Attach Image'
      Hint = 'Attach an image to the next message'
      OnExecute = AttachImageActionExecute
    end
    object RemoveAttachmentAction: TAction
