    ShowButtons = [pbOK, pbCancel]
  end
  object AddConnectionMenu: TPopupMenu
    Left = 8
    Top = 8
    object GrokAccountItem: TMenuItem
      Caption = 'Grok account'
      OnClick = AddGrokAccountClick
    end
    object ChatGptAccountItem: TMenuItem
