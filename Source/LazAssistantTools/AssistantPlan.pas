Procedure PublishPlanFileWrite(Const Resolved, Content: String; OpenAfter: Boolean);
Begin
  { The progress list listens on the bus. Do not rely on a viewer being open. }
  If Assigned(WorkflowEventBus) And (Resolved <> '') Then
    Begin
      WorkflowEventBus.NotifyDocumentSaved(Resolved);
      WorkflowEventBus.NotifyDocumentChanged(Resolved, Content);
    End;
  { A plan run updates the summary list. Do not steal the window by opening a viewer. }
  If PlanViewerQuiet Then
    Begin
      If Assigned(FindMarkdownDocument(Resolved)) Then
        ReloadMarkdownDocument(Resolved, False, False);
    End
  Else If Assigned(FindMarkdownDocument(Resolved)) Then
    ReloadMarkdownDocument(Resolved, True)
  Else If OpenAfter Then
    OpenMarkdownDocument(Resolved);
End;

Function PlanProjectRoot: String;
Begin
  { Independent of AssistantTools to avoid a unit cycle. }
  Result := ProjectAssistantRoot;
End;

Function PlanIsUnderRoot(Const Root, Candidate: String): Boolean;
Var
  LexRoot, LexCand, Probe, PhysRoot, PhysCand: String;
Begin
  Result := False;
  LexRoot := IncludeTrailingPathDelimiter(ExpandFileName(Root));
  LexCand := ExpandFileName(Candidate);
  If (LexCand = '') Or ((CompareFilenames(Copy(LexCand, 1, Length(LexRoot)), LexRoot) <> 0) And
     (CompareFilenames(ExcludeTrailingPathDelimiter(LexCand), ExcludeTrailingPathDelimiter(LexRoot)) <> 0)) Then
    Exit;
  PhysRoot := GetPhysicalFilename(ExcludeTrailingPathDelimiter(LexRoot), pfeOriginal);
  If PhysRoot = '' Then
    PhysRoot := ExcludeTrailingPathDelimiter(LexRoot);
  PhysRoot := IncludeTrailingPathDelimiter(ExpandFileName(PhysRoot));
  Probe := LexCand;
  While (Probe <> '') And (Not FileExistsUTF8(Probe)) And (Not DirectoryExistsUTF8(Probe)) Do
    Begin
      If ExtractFileDir(Probe) = Probe Then
        Break;
      Probe := ExcludeTrailingPathDelimiter(ExtractFileDir(Probe));
    End;
  If (Not FileExistsUTF8(Probe)) And (Not DirectoryExistsUTF8(Probe)) Then
    Begin
      Result := True;
      Exit;
    End;
  PhysCand := GetPhysicalFilename(Probe, pfeEmpty);
  If PhysCand = '' Then
    Exit;
  PhysCand := ExpandFileName(PhysCand);
  Result := (CompareFilenames(Copy(PhysCand, 1, Length(PhysRoot)), PhysRoot) = 0) Or
    (CompareFilenames(ExcludeTrailingPathDelimiter(PhysCand), ExcludeTrailingPathDelimiter(PhysRoot)) = 0);
End;

Function PlanResolveUnderProject(Const RelativeOrAbsolute: String; Out Resolved: String;
  Out ErrorText: String): Boolean;
Var
  Root, Cand: String;
Begin
  Result := False;
  Resolved := '';
  ErrorText := '';
  Root := PlanProjectRoot;
  If Root = '' Then
    Begin
      ErrorText := 'No active Lazarus project is open.';
      Exit;
    End;
  Cand := Trim(RelativeOrAbsolute);
  If Cand = '' Then
    Cand := Root
  Else If FilenameIsAbsolute(Cand) Then
    Cand := ExpandFileName(Cand)
  Else
    Cand := ExpandFileName(Root + Cand);
  If Not PlanIsUnderRoot(Root, Cand) Then
    Begin
      ErrorText := 'Path is outside the active project root: ' + Cand;
      Exit;
    End;
  Resolved := Cand;
  Result := True;
End;

Function ProjectDocumentsDir: String;
Var
  Root: String;
Begin
  Root := PlanProjectRoot;
  If Root = '' Then
    Result := ''
  Else
    Result := IncludeTrailingPathDelimiter(Root + AssistantDocumentsDirName);
End;

Function EnsureProjectDocumentsDir(Out ErrorText: String): Boolean;
Var
  Dir: String;
Begin
  Result := False;
  ErrorText := '';
  Dir := ExcludeTrailingPathDelimiter(ProjectDocumentsDir);
  If Dir = '' Then
    Begin
      ErrorText := 'No active Lazarus project.';
      Exit;
    End;
  If DirectoryExistsUTF8(Dir) Then
    Begin
      Result := True;
      Exit;
    End;
  If ForceDirectoriesUTF8(Dir) Then
    Begin
      Result := True;
      WorkflowLogger.Info('AssistantPlan', 'Created Documents folder: ' + Dir);
    End
  Else
    ErrorText := 'Could not create Documents folder: ' + Dir;
End;

Function DefaultPlanRelativePath: String;
Begin
  Result := AssistantDocumentsDirName + PathDelim + AssistantDefaultPlanFileName;
End;

Function NewDocumentRelativePath: String;
Begin
  Result := AssistantDocumentsDirName + '/Report-' + FormatDateTime('yyyymmdd-hhnnss', Now) + '.md';
End;

Function GetDocumentRelativePath: String;
Begin
  Result := DocumentRelativePath;
End;

Procedure SetDocumentRelativePath(Const RelativePath: String);
Begin
  DocumentRelativePath := StringReplace(Trim(RelativePath), '\', '/', [rfReplaceAll]);
End;

Procedure RememberDocumentRelativePath(Const RelativePath: String);
Begin
  SetDocumentRelativePath(RelativePath);
  If Assigned(ProjectAssistantConversation) And (ProjectAssistantConversation.ProjectRoot <> '') Then
    ProjectAssistantConversation.SaveDocumentFile(DocumentRelativePath);
End;

Function DocumentPathForTurn: String;
Begin
  Result := GetDocumentRelativePath;
  If Result = '' Then
    Begin
      Result := NewDocumentRelativePath;
      RememberDocumentRelativePath(Result);
    End;
End;

Function AssistantDocumentDirective(Const DocumentPath: String): String;
Begin
  Result :=
    '[SYSTEM DIRECTIVE — Document mode] When this request produces or revises a document, write it with ' +
    'write_markdown or update_markdown (path: "' + DocumentPath + '"). ';
  Result := Result +
    'Chat reply must be a short summary only, not the full document body. ' +
    'Use free Markdown. The user''s prompt decides the layout. ' +
    'Do not use the assistant plan format. Do not add the line "' + AssistantPlanGeneratedLine + '". ' +
    'Do not add Status lines. Do not call set_active_plan. Do not edit source files. ' +
    'Do not write the active plan. ' +
    'If the user asks for a new document, use a new Documents/Report-YYYYMMDD-HHMMSS.md path and do not overwrite this file. ' +
    'A question that does not ask for a document or a change does not need a write.';
End;

Function AssistantPlanDirective(Const PlanPath: String): String;
Begin
  Result :=
    '[SYSTEM DIRECTIVE — Plan mode] Write the plan into the project Markdown file ' +
    'using the write_markdown tool (path: "' + PlanPath +
    '"). Chat reply must be a short summary only, not the full plan body. ' +
    'Use the assistant plan format: an H1 title, then `' + AssistantPlanGeneratedLine +
    '`, numbered ## sections without Status, and ### items with Status.';
End;

Function IsMarkdownPath(Const Path: String): Boolean;
Var
  Ext: String;
Begin
  Ext := LowerCase(ExtractFileExt(Path));
  Result := (Ext = '.md') Or (Ext = '.markdown') Or (Ext = '.mdown');
End;

Function ProjectRelativePath(Const AbsolutePath: String): String;
Var
  Root, Full: String;
Begin
  Result := AbsolutePath;
  Root := PlanProjectRoot;
  If Root = '' Then
    Exit;
  Full := ExpandFileName(AbsolutePath);
  Root := IncludeTrailingPathDelimiter(ExpandFileName(Root));
  {$IFDEF WINDOWS}
  If SameText(Copy(Full, 1, Length(Root)), Root) Then
    Result := Copy(Full, Length(Root) + 1, MaxInt)
  Else If SameText(ExcludeTrailingPathDelimiter(Full), ExcludeTrailingPathDelimiter(Root)) Then
    Result := '';
  {$ELSE}
  If Copy(Full, 1, Length(Root)) = Root Then
    Result := Copy(Full, Length(Root) + 1, MaxInt)
  Else If ExcludeTrailingPathDelimiter(Full) = ExcludeTrailingPathDelimiter(Root) Then
    Result := '';
  {$ENDIF}
  Result := StringReplace(Result, '\', '/', [rfReplaceAll]);
End;

Function ResolvePlanPath(Const RelativeOrAbsolute: String; Out Resolved: String;
  Out ErrorText: String): Boolean;
Var
  Cand: String;
Begin
  Result := False;
  Resolved := '';
  ErrorText := '';
  Cand := Trim(RelativeOrAbsolute);
  If Cand = '' Then
    Cand := DefaultPlanRelativePath;
  If Not PlanResolveUnderProject(Cand, Resolved, ErrorText) Then
    Exit;
  If Not IsMarkdownPath(Resolved) Then
    Begin
      ErrorText := 'Plan tools only allow Markdown paths (.md): ' + Resolved;
      Resolved := '';
      Exit;
    End;
  Result := True;
End;

Function IsAssistantPlanGeneratedLine(Const Line: String): Boolean;
Var
  S: String;
Begin
  S := Trim(Line);
  Result := (S = AssistantPlanGeneratedLine) Or (S = 'Generated by Lazarus Project Assistant');
End;

{ ATX heading with a required space after the hashes. 0 when the line is not a heading. }
Function PlanHeadingLevel(Const Line: String; Out Title: String): Integer;
Var
  S: String;
  I: Integer;
Begin
  Result := 0;
  Title := '';
  S := Trim(Line);
  If (S = '') Or (S[1] <> '#') Then
    Exit;
  I := 1;
  While (I <= Length(S)) And (S[I] = '#') Do
    Inc(I);
  Result := I - 1;
  If (Result < 1) Or (Result > 6) Or (I > Length(S)) Or (S[I] <> ' ') Then
    Begin
      Result := 0;
      Exit;
    End;
  Title := Trim(Copy(S, I + 1, MaxInt));
  If Title = '' Then
    Result := 0;
End;

Function PlanIdentityFromLines(Lines: TStrings; Out Title: String): Boolean;
Var
  I, Seen, Level: Integer;
  Heading: String;
Begin
  Result := False;
  Title := '';
  Seen := 0;
  I := 0;
  While (I < Lines.Count) And (Seen < 2) Do
    Begin
      If Trim(Lines[I]) = '' Then
        Begin
          Inc(I);
          Continue;
        End;
      Inc(Seen);
      If Seen = 1 Then
        Begin
          Level := PlanHeadingLevel(Lines[I], Heading);
          If Level <> 1 Then
            Exit;
          Title := Heading;
        End
      Else
        Result := IsAssistantPlanGeneratedLine(Lines[I]);
      Inc(I);
    End;
End;

Procedure PlanLinesFromHead(Const Head: String; Lines: TStrings);
Var
  SL: TStringList;
  I, Limit: Integer;
  Body: String;
Begin
  Body := Head;
  If (Length(Body) >= 3) And (Body[1] = #$EF) And (Body[2] = #$BB) And (Body[3] = #$BF) Then
    Delete(Body, 1, 3);
  SL := TStringList.Create;
  Try
    SL.Text := Body;
    Limit := SL.Count;
    If Limit > AssistantPlanIdentityMaxLines Then
      Limit := AssistantPlanIdentityMaxLines;
    For I := 0 To Limit - 1 Do
      Lines.Add(SL[I]);
  Finally
    SL.Free;
  End;
End;

Function ReadPlanTextHead(Const FileName: String): String;
Var
  Stream: TFileStream;
  Count: Integer;
Begin
  Result := '';
  Try
    Stream := TFileStream.Create(FileName, fmOpenRead Or fmShareDenyNone);
  Except
    Exit;
  End;
  Try
    Count := Stream.Size;
    If Count > AssistantPlanIdentityMaxBytes Then
      Count := AssistantPlanIdentityMaxBytes;
    If Count < 1 Then
      Exit;
    SetLength(Result, Count);
    Count := Stream.Read(Result[1], Count);
    If Count < 0 Then
      Count := 0;
    SetLength(Result, Count);
  Finally
    Stream.Free;
  End;
End;

Function TextIsAssistantPlan(Const Body: String): Boolean;
Var
  Title: String;
  Lines: TStringList;
Begin
  Lines := TStringList.Create;
  Try
    PlanLinesFromHead(Copy(Body, 1, AssistantPlanIdentityMaxBytes), Lines);
    Result := PlanIdentityFromLines(Lines, Title);
  Finally
    Lines.Free;
  End;
End;

Function TryReadAssistantPlanIdentity(Const RelativeOrAbsolute: String; Out Title, ErrorText: String): Boolean;
Var
  Resolved: String;
  Lines: TStringList;
Begin
  Result := False;
  Title := '';
  ErrorText := '';
  If Not PlanResolveUnderProject(RelativeOrAbsolute, Resolved, ErrorText) Then
    Exit;
  If Not FileExistsUTF8(Resolved) Then
    Begin
      ErrorText := 'Plan file not found: ' + Resolved;
      Exit;
    End;
  Lines := TStringList.Create;
  Try
    PlanLinesFromHead(ReadPlanTextHead(Resolved), Lines);
    Result := PlanIdentityFromLines(Lines, Title);
    If Not Result Then
      ErrorText := 'Not a recognised assistant plan.';
  Finally
    Lines.Free;
  End;
End;

Function FormatPlanListCaption(Const Title, RelativePath: String): String;
Var
  DisplayTitle: String;
Begin
  DisplayTitle := Trim(Title);
  If DisplayTitle = '' Then
    DisplayTitle := ChangeFileExt(ExtractFileName(RelativePath), '');
  Result := DisplayTitle + ' (' + RelativePath + ')';
End;

Function PlanComboCaption(Const Title, RelativePath: String): String;
Begin
  Result := Trim(Title);
  If Result = '' Then
    Result := ChangeFileExt(ExtractFileName(StringReplace(RelativePath, '/', PathDelim, [rfReplaceAll])), '');
End;

Procedure SetAssistantPlanViewerQuiet(Quiet: Boolean);
Begin
  PlanViewerQuiet := Quiet;
End;

Function AssistantPlanViewerQuiet: Boolean;
Begin
  Result := PlanViewerQuiet;
End;

Function NormalizeAvailablePlanPath(Const RelativePath: String): String;
Begin
  Result := StringReplace(Trim(RelativePath), '\', '/', [rfReplaceAll]);
End;

Function AvailablePlanIndex(Paths: TStrings; Const RelativePath: String): Integer;
Var
  I: Integer;
  Norm: String;
Begin
  Result := -1;
  Norm := NormalizeAvailablePlanPath(RelativePath);
  If (Norm = '') Or (Not Assigned(Paths)) Then
    Exit;
  For I := 0 To Paths.Count - 1 Do
    If SameText(NormalizeAvailablePlanPath(Paths[I]), Norm) Then
      Begin
        Result := I;
        Exit;
      End;
End;

Function AvailablePlanStoreReady(Out ErrorText: String): Boolean;
Begin
  Result := Assigned(ProjectAssistantConversation) And (ProjectAssistantConversation.ProjectRoot <> '');
  If Not Result Then
    ErrorText := 'No project assistant store.';
End;

Function ListAvailableAssistantPlans(Const ActiveRelative: String; Out Paths, Titles: TStringList;
  Out ActiveMissing: Boolean; Out ErrorText: String): Boolean;
Var
  Stored, Kept: TStringList;
  I: Integer;
  Rel, Resolved, Title, Err: String;
  Changed: Boolean;
Begin
  Result := False;
  ErrorText := '';
  ActiveMissing := False;
  Paths := TStringList.Create;
  Titles := TStringList.Create;
  If Not AvailablePlanStoreReady(ErrorText) Then
    Exit;
  Stored := TStringList.Create;
  Kept := TStringList.Create;
  Try
    If Not ProjectAssistantConversation.LoadAvailablePlanPaths(Stored) Then
      Begin
        ErrorText := ProjectAssistantConversation.LastError;
        Exit;
      End;
    Changed := False;
    For I := 0 To Stored.Count - 1 Do
      Begin
        Rel := NormalizeAvailablePlanPath(Stored[I]);
        If (Rel = '') Or (AvailablePlanIndex(Kept, Rel) >= 0) Then
          Begin
            Changed := True;
            Continue;
          End;
        If (Not ResolvePlanPath(Rel, Resolved, Err)) Or (Not FileExistsUTF8(Resolved)) Then
          Begin
            Changed := True;
            Continue;
          End;
        Kept.Add(Rel);
      End;
    { Keep the plan already chosen. Do not scan the project for the rest. }
    Rel := NormalizeAvailablePlanPath(ActiveRelative);
    If Rel <> '' Then
      Begin
        If (Not ResolvePlanPath(Rel, Resolved, Err)) Or (Not FileExistsUTF8(Resolved)) Then
          ActiveMissing := True
        Else If (AvailablePlanIndex(Kept, Rel) < 0) And TryReadAssistantPlanIdentity(Resolved, Title, Err) Then
          Begin
            Kept.Add(Rel);
            Changed := True;
          End;
      End;
    If Changed And (Not ProjectAssistantConversation.SaveAvailablePlanPaths(Kept)) Then
      Begin
        ErrorText := ProjectAssistantConversation.LastError;
        Exit;
      End;
    For I := 0 To Kept.Count - 1 Do
      Begin
        Rel := Kept[I];
        Title := '';
        If ResolvePlanPath(Rel, Resolved, Err) Then
          TryReadAssistantPlanIdentity(Resolved, Title, Err);
        Paths.Add(Rel);
        Titles.Add(PlanComboCaption(Title, Rel));
      End;
    Result := True;
  Finally
    Stored.Free;
    Kept.Free;
  End;
End;

Function AddAvailableAssistantPlan(Const RelativeOrAbsolute: String; Out ErrorText: String): Boolean;
Var
  Resolved, Rel, Title: String;
  Paths: TStringList;
Begin
  Result := False;
  ErrorText := '';
  If Not TryReadAssistantPlanIdentity(RelativeOrAbsolute, Title, ErrorText) Then
    Exit;
  If Not ResolvePlanPath(RelativeOrAbsolute, Resolved, ErrorText) Then
    Exit;
  Rel := NormalizeAvailablePlanPath(ProjectRelativePath(Resolved));
  If Rel = '' Then
    Begin
      ErrorText := 'Plan path is outside the project.';
      Exit;
    End;
  If Not AvailablePlanStoreReady(ErrorText) Then
    Exit;
  Paths := TStringList.Create;
  Try
    If Not ProjectAssistantConversation.LoadAvailablePlanPaths(Paths) Then
      Begin
        ErrorText := ProjectAssistantConversation.LastError;
        Exit;
      End;
    If AvailablePlanIndex(Paths, Rel) < 0 Then
      Paths.Add(Rel);
    Result := ProjectAssistantConversation.SaveAvailablePlanPaths(Paths);
    If Not Result Then
      ErrorText := ProjectAssistantConversation.LastError;
  Finally
    Paths.Free;
  End;
End;

Function RemoveAvailableAssistantPlan(Const RelativeOrAbsolute: String; Out ErrorText: String): Boolean;
Var
  Resolved, Rel, Err: String;
  Paths: TStringList;
  Index: Integer;
Begin
  Result := False;
  ErrorText := '';
  Rel := NormalizeAvailablePlanPath(RelativeOrAbsolute);
  If ResolvePlanPath(RelativeOrAbsolute, Resolved, Err) Then
    Rel := NormalizeAvailablePlanPath(ProjectRelativePath(Resolved));
  If Rel = '' Then
    Begin
      ErrorText := 'No plan path to remove.';
      Exit;
    End;
  If Not AvailablePlanStoreReady(ErrorText) Then
    Exit;
  Paths := TStringList.Create;
  Try
    If Not ProjectAssistantConversation.LoadAvailablePlanPaths(Paths) Then
      Begin
        ErrorText := ProjectAssistantConversation.LastError;
        Exit;
      End;
    Index := AvailablePlanIndex(Paths, Rel);
    If Index >= 0 Then
      Paths.Delete(Index);
    Result := ProjectAssistantConversation.SaveAvailablePlanPaths(Paths);
    If Not Result Then
      ErrorText := ProjectAssistantConversation.LastError;
  Finally
    Paths.Free;
  End;
End;

Function AssistantPlanAuthoringRules: String;
Begin
  Result :=
    'Assistant plan files use this format:' + LineEnding +
    '- First line is a level-1 heading: `# Plan title`.' + LineEnding +
    '- The next non-empty line is exactly: `' + AssistantPlanGeneratedLine + '`' + LineEnding +
    '- Only files with that identity line are assistant plans. The plan list is the set registered in ' +
    'the project .assistant settings. A folder scan does not add plans.' + LineEnding +
    '- `## N. Section title` is context (N = 1, 2, 3…). Do not put a Status line under `##`.' + LineEnding +
    '- `### N.M Item title` is an actionable item (1.1, 1.2, 2.1…). The next non-empty line must be ' +
    '`Status: not started`, `Status: in progress`, or `Status: complete`.' + LineEnding +
    '- A `###` heading without that Status line is a note and is not a todo.' + LineEnding +
    '- Heading numbers are the only numbers. Do not add a second numbering scheme.' + LineEnding +
    '- Preamble and overview prose go before the first `##`, or under a `##` section with no Status line.';
End;

Function AssistantPlanCompletionRules: String;
Begin
  Result :=
    'When an actionable item is finished, set its Status to complete with update_markdown. ' +
    'Do not put Status on a ## heading. A clean compile does not complete the item. ' +
    'If the working root is a Git repository, run_git commit must succeed in this turn before Status becomes complete. ' +
    'Commit the finished files first, then set the status, then commit the plan file. ' +
    'Use one -m string for the subject and body, or several -m arguments; Git joins them with a blank line. ' +
    'A commit may end with -- and the files to record, so other staged files stay staged. ' +
    'If the turn ends with Status complete and that plan file is still uncommitted, the assistant commits the plan file and keeps the status. ' +
    'If the working root has no Git repository, set Status to complete with no commit. ' +
    'Report a commit hash only from a successful run_git result. If a tool fails, say so. ' +
    'During a plan run, do not open the plan viewer. Status changes update the summary list. ' +
    'If that Markdown window is already open, it is refreshed.';
End;

Procedure AppendPlanPair(Target: TStringList; Const RelativePath, Title: String);
Begin
  Target.Add(RelativePath + #1 + Title);
End;

Procedure EmitPlanPairs(Source, Paths, Titles: TStringList);
Var
  I, SplitAt: Integer;
  Item, Rel, Title: String;
Begin
  For I := 0 To Source.Count - 1 Do
    Begin
      Item := Source[I];
      SplitAt := Pos(#1, Item);
      If SplitAt < 2 Then
        Continue;
      Rel := Copy(Item, 1, SplitAt - 1);
      Title := Copy(Item, SplitAt + 1, MaxInt);
      If Title = '' Then
        Title := ChangeFileExt(ExtractFileName(Rel), '');
      Paths.Add(Rel);
      Titles.Add(Title);
    End;
End;

Function ListProjectMarkdownPlans(Out Paths, Titles: TStringList; Out ErrorText: String): Boolean;
Var
  Root, Rel, LowerRel, DocsPrefix, PlanTitle, IdentityErr: String;
  Files, DocsFirst, Rest: TStringList;
  I: Integer;
Begin
  Result := False;
  ErrorText := '';
  Paths := TStringList.Create;
  Titles := TStringList.Create;
  Root := PlanProjectRoot;
  If Root = '' Then
    Begin
      ErrorText := 'No active Lazarus project.';
      Exit;
    End;
  DocsPrefix := LowerCase(AssistantDocumentsDirName + '/');
  DocsFirst := TStringList.Create;
  Rest := TStringList.Create;
  Files := FindAllFiles(Root, '*.md', True);
  Try
    DocsFirst.Sorted := True;
    DocsFirst.Duplicates := dupIgnore;
    Rest.Sorted := True;
    Rest.Duplicates := dupIgnore;
    For I := 0 To Files.Count - 1 Do
      Begin
        If Not IsMarkdownPath(Files[I]) Then
          Continue;
        Rel := ProjectRelativePath(Files[I]);
        If Rel = '' Then
          Continue;
        If Not TryReadAssistantPlanIdentity(Files[I], PlanTitle, IdentityErr) Then
          Continue;
        LowerRel := LowerCase(StringReplace(Rel, '\', '/', [rfReplaceAll]));
        If Pos(DocsPrefix, LowerRel) = 1 Then
          AppendPlanPair(DocsFirst, Rel, PlanTitle)
        Else
          AppendPlanPair(Rest, Rel, PlanTitle);
      End;
    EmitPlanPairs(DocsFirst, Paths, Titles);
    EmitPlanPairs(Rest, Paths, Titles);
    Result := True;
  Finally
    Files.Free;
    DocsFirst.Free;
    Rest.Free;
  End;
End;

Function DefaultNewPlanMarkdown(Const Title: String): String;
Var
  T: String;
Begin
  T := Trim(Title);
  If T = '' Then
    T := 'Project Plan';
  Result :=
    '# ' + T + LineEnding +
    LineEnding +
    AssistantPlanGeneratedLine + LineEnding +
    LineEnding +
    'Work packages use a `##` heading. Actionable items use a `###` heading and a `Status:` line ' +
    'so Build mode can scan this file for TODO tiles.' + LineEnding +
    LineEnding +
    'Status values: `not started` | `in progress` | `complete`' + LineEnding +
    LineEnding +
    '## 1. Overview' + LineEnding +
    LineEnding +
    'Describe goals, constraints, and success criteria.' + LineEnding +
    LineEnding +
    '## 2. First work package' + LineEnding +
    LineEnding +
    'Describe this work package.' + LineEnding +
    LineEnding +
    '### 2.1 First actionable item' + LineEnding +
    'Status: ' + AssistantPlanStatusNotStarted + LineEnding +
    LineEnding +
    'Concrete implementation notes for the first work item.' + LineEnding;
End;

Function DetectFileEol(Const S: String): String;
Begin
  If Pos(#13#10, S) > 0 Then
    Result := #13#10
  Else If Pos(#13, S) > 0 Then
    Result := #13
  Else
    Result := #10;
End;

Function NormalizeToEol(Const S, Eol: String): String;
Begin
  Result := StringReplace(S, #13#10, #10, [rfReplaceAll]);
  Result := StringReplace(Result, #13, #10, [rfReplaceAll]);
  If (Eol <> '') And (Eol <> #10) Then
    Result := StringReplace(Result, #10, Eol, [rfReplaceAll]);
End;

Function ReadFileBytes(Const Path: String; Out Body: String): Boolean;
Var
  Stream: TFileStream;
Begin
  Result := False;
  Body := '';
  Stream := Nil;
  Try
    Try
      Stream := TFileStream.Create(Path, fmOpenRead Or fmShareDenyWrite);
      SetLength(Body, Stream.Size);
      If Length(Body) > 0 Then
        Stream.ReadBuffer(Body[1], Length(Body));
      Result := True;
    Except
      Result := False;
      Body := '';
    End;
  Finally
    Stream.Free;
  End;
End;

{ Existing non-symlink files keep the ending already on disk. New files and symlinks use LF. }
Function PlanFileLineBreak(Const Path: String): String;
Var
  Raw: String;
Begin
  Result := #10;
  If (Path = '') Or FileIsSymlink(Path) Or (Not FileExistsUTF8(Path)) Then
    Exit;
  If Not ReadFileBytes(Path, Raw) Then
    Exit;
  Result := DetectFileEol(Raw);
End;

Function WriteMarkdownFile(Const RelativeOrAbsolute, Content: String; OpenAfter: Boolean;
  Out Resolved: String; Out ErrorText: String): Boolean;
Var
  Dir, Previous: String;
  Existed: Boolean;
  SL: TStringList;
Begin
  Result := False;
  Resolved := '';
  ErrorText := '';
  If Not ResolvePlanPath(RelativeOrAbsolute, Resolved, ErrorText) Then
    Exit;
  Dir := ExtractFilePath(Resolved);
  If (Dir <> '') And (Not DirectoryExistsUTF8(Dir)) Then
    If Not ForceDirectoriesUTF8(Dir) Then
      Begin
        ErrorText := 'Could not create directory: ' + Dir;
        Exit;
      End;
  If PlanMarkdownStructureError(Content, ErrorText) Then
    Exit;
  Previous := '';
  Existed := FileExistsUTF8(Resolved) And (Not FileIsSymlink(Resolved));
  If Existed Then
    Begin
      SL := TStringList.Create;
      Try
        SL.LoadFromFile(Resolved);
        SL.LineBreak := PlanFileLineBreak(Resolved);
        Previous := SL.Text;
      Finally
        SL.Free;
      End;
    End;
  If PlanCompletionBlocked(Previous, Content, ErrorText) Then
    Exit;
  SL := TStringList.Create;
  Try
    Try
      SL.Text := Content;
      SL.LineBreak := PlanFileLineBreak(Resolved);
      SL.SaveToFile(Resolved);
      Result := True;
      If PlanBodyIntroducesCompletion(Previous, Content) Then
        NotePlanCompletionWrite(Resolved, Previous, Existed);
      WorkflowLogger.Info('AssistantPlan', 'Wrote Markdown: ' + Resolved);
      PublishPlanFileWrite(Resolved, SL.Text, OpenAfter);
    Except
      On E: Exception Do
        ErrorText := E.Message;
    End;
  Finally
    SL.Free;
  End;
End;

Function ReplaceInMarkdownFile(Const RelativeOrAbsolute, OldText, NewText: String;
  ReplaceAll, OpenAfter: Boolean; Out Resolved: String; Out ErrorText: String;
  Out ReplaceCount: Integer): Boolean;
Var
  SL: TStringList;
  Body, Previous, FileEol, SearchText, Replacement: String;
  P: Integer;
Begin
  Result := False;
  Resolved := '';
  ErrorText := '';
  ReplaceCount := 0;
  If OldText = '' Then
    Begin
      ErrorText := 'old_text must not be empty.';
      Exit;
    End;
  If Not ResolvePlanPath(RelativeOrAbsolute, Resolved, ErrorText) Then
    Exit;
  If Not FileExistsUTF8(Resolved) Then
    Begin
      ErrorText := 'Markdown file not found: ' + Resolved;
      Exit;
    End;
  SL := TStringList.Create;
  Try
    Try
      SL.LoadFromFile(Resolved);
      FileEol := PlanFileLineBreak(Resolved);
      SL.LineBreak := FileEol;
      Previous := SL.Text;
      Body := Previous;
      SearchText := OldText;
      If Pos(SearchText, Body) < 1 Then
        Begin
          SearchText := NormalizeToEol(OldText, FileEol);
          If (SearchText = OldText) Or (Pos(SearchText, Body) < 1) Then
            Begin
              ErrorText := 'old_text not found in ' + Resolved;
              Exit;
            End;
        End;
      Replacement := NormalizeToEol(NewText, FileEol);
      If ReplaceAll Then
        Begin
          ReplaceCount := 0;
          P := 1;
          While P <= Length(Body) Do
            If Copy(Body, P, Length(SearchText)) = SearchText Then
              Begin
                Inc(ReplaceCount);
                Inc(P, Length(SearchText));
              End
            Else
              Inc(P);
          If ReplaceCount < 1 Then
            Begin
              ErrorText := 'old_text not found in ' + Resolved;
              Exit;
            End;
          Body := StringReplace(Body, SearchText, Replacement, [rfReplaceAll]);
        End
      Else
        Begin
          P := Pos(SearchText, Body);
          If P < 1 Then
            Begin
              ErrorText := 'old_text not found in ' + Resolved;
              Exit;
            End;
          Body := Copy(Body, 1, P - 1) + Replacement + Copy(Body, P + Length(SearchText), MaxInt);
          ReplaceCount := 1;
        End;
      If PlanMarkdownStructureError(Body, ErrorText) Then
        Begin
          ReplaceCount := 0;
          Exit;
        End;
      If PlanCompletionBlocked(Previous, Body, ErrorText) Then
        Begin
          ReplaceCount := 0;
          Exit;
        End;
      SL.Text := Body;
      SL.LineBreak := FileEol;
      SL.SaveToFile(Resolved);
      Result := True;
      If PlanBodyIntroducesCompletion(Previous, Body) Then
        NotePlanCompletionWrite(Resolved, Previous, True);
      WorkflowLogger.Info('AssistantPlan',
        Format('Updated Markdown %s (%d replacement(s))', [Resolved, ReplaceCount]));
      PublishPlanFileWrite(Resolved, SL.Text, OpenAfter);
    Except
      On E: Exception Do
        ErrorText := E.Message;
    End;
  Finally
    SL.Free;
  End;
End;

Function PlanSectionStatusToStr(Status: TPlanSectionStatus): String;
Begin
  Case Status Of
    pssNotStarted: Result := AssistantPlanStatusNotStarted;
    pssInProgress: Result := AssistantPlanStatusInProgress;
    pssComplete: Result := AssistantPlanStatusComplete;
  Else
    Result := 'unknown';
  End;
End;

Function StrToPlanSectionStatus(Const StatusText: String): TPlanSectionStatus;
Var
  T: String;
Begin
  T := LowerCase(Trim(StatusText));
  T := StringReplace(T, '*', '', [rfReplaceAll]);
  T := Trim(T);
  If (T = AssistantPlanStatusNotStarted) Or (T = 'todo') Or (T = 'pending') Then
    Result := pssNotStarted
  Else If (T = AssistantPlanStatusInProgress) Or (T = 'wip') Or (T = 'doing') Then
    Result := pssInProgress
  Else If (T = AssistantPlanStatusComplete) Or (T = 'done') Or (T = 'finished') Then
    Result := pssComplete
  Else
    Result := pssUnknown;
End;

Function FormatPlanSectionTile(Section: TPlanSection): String;
Var
  StatusLabel: String;
Begin
  If Not Assigned(Section) Then
    Begin
      Result := '';
      Exit;
    End;
  If Not Section.Actionable Then
    Begin
      Result := Section.Title;
      Exit;
    End;
  Case Section.Status Of
    pssNotStarted: StatusLabel := 'Not started';
    pssInProgress: StatusLabel := 'In progress';
    pssComplete: StatusLabel := 'Complete';
  Else
    StatusLabel := 'No status';
  End;
  { Middle dot survives list boxes that trim leading spaces. }
  Result := '· ' + Section.Title + ' — ' + StatusLabel;
End;

Function ParseStatusLine(Const Line: String; Out StatusText: String): Boolean; Forward;

Function PlanMarkdownStructureError(Const Content: String; Out ErrorText: String): Boolean;
Var
  Lines: TStringList;
  I, Level, FenceLength, N: Integer;
  Heading, StatusText, Line: String;
  Fence: Char;
  SectionLevel: Integer;
Begin
  Result := False;
  ErrorText := '';
  If Not TextIsAssistantPlan(Content) Then
    Exit;
  Lines := TStringList.Create;
  Try
    Lines.Text := Content;
    Fence := #0;
    FenceLength := 0;
    SectionLevel := 0;
    For I := 0 To Lines.Count - 1 Do
      Begin
        Line := Trim(Lines[I]);
        If (Length(Line) >= 3) And ((Line[1] = '`') Or (Line[1] = '~')) Then
          Begin
            N := 1;
            While (N <= Length(Line)) And (Line[N] = Line[1]) Do
              Inc(N);
            Dec(N);
            If N >= 3 Then
              Begin
                If Fence = #0 Then
                  Begin
                    Fence := Line[1];
                    FenceLength := N;
                  End
                Else If (Line[1] = Fence) And (N >= FenceLength) And (Trim(Copy(Line, N + 1, MaxInt)) = '') Then
                  Fence := #0;
                Continue;
              End;
          End;
        If Fence <> #0 Then
          Continue;
        Level := PlanHeadingLevel(Lines[I], Heading);
        If Level In [1, 2, 3] Then
          Begin
            SectionLevel := Level;
            Continue;
          End;
        { Status under ## is rejected. A later Status line in a ### note does not make that note a todo. }
        If ParseStatusLine(Lines[I], StatusText) And (SectionLevel = 2) Then
          Begin
            ErrorText := 'A Status: line cannot sit under a ## heading. Put Status only on a ### item. ' +
              'A ### heading without Status is a note, not a todo.';
            Result := True;
            Exit;
          End;
      End;
  Finally
    Lines.Free;
  End;
End;

Function ParseStatusLine(Const Line: String; Out StatusText: String): Boolean;
Var
  S, Lower: String;
  P: Integer;
Begin
  Result := False;
  StatusText := '';
  S := Trim(Line);
  S := StringReplace(S, '**', '', [rfReplaceAll]);
  S := StringReplace(S, '*', '', [rfReplaceAll]);
  S := Trim(S);
  Lower := LowerCase(S);
  If Pos('status:', Lower) <> 1 Then
    Exit;
  P := Pos(':', S);
  If P < 1 Then
    Exit;
  StatusText := Trim(Copy(S, P + 1, MaxInt));
  Result := StatusText <> '';
End;

Procedure BlankFencedLines(Lines: TStringList);
Var
  Index, FenceLength, Mark: Integer;
  Fence: Char;
  Line: String;
Begin
  Fence := #0;
  FenceLength := 0;
  For Index := 0 To Lines.Count - 1 Do
    Begin
      Line := Trim(Lines[Index]);
      If (Length(Line) >= 3) And ((Line[1] = '`') Or (Line[1] = '~')) Then
        Begin
          Mark := 1;
          While (Mark <= Length(Line)) And (Line[Mark] = Line[1]) Do
            Inc(Mark);
          Dec(Mark);
          If Mark >= 3 Then
            Begin
              If Fence = #0 Then
                Begin
                  Fence := Line[1];
                  FenceLength := Mark;
                End
              Else If (Line[1] = Fence) And (Mark >= FenceLength) And (Trim(Copy(Line, Mark + 1, MaxInt)) = '') Then
                Fence := #0;
              Lines[Index] := '';
              Continue;
            End;
        End;
      If Fence <> #0 Then
        Lines[Index] := '';
    End;
End;

Procedure CollectCompleteKeys(Const Body: String; Keys: TStrings);
Var
  Lines: TStringList;
  Index, Level, StatusLine: Integer;
  Title, StatusText, ParentTitle: String;
Begin
  If Not Assigned(Keys) Then Exit;
  Lines := TStringList.Create;
  Try
    Lines.Text := Body;
    BlankFencedLines(Lines);
    ParentTitle := '';
    For Index := 0 To Lines.Count - 1 Do
      Begin
        Level := PlanHeadingLevel(Lines[Index], Title);
        If Level = 2 Then
          ParentTitle := Title
        Else If Level = 1 Then
          ParentTitle := ''
        Else If (Level = 3) And StatusFollowsHeading(Lines, Index, StatusText, StatusLine) And
          (StrToPlanSectionStatus(StatusText) = pssComplete) Then
          Keys.Add(ParentTitle + #1 + Title);
      End;
  Finally
    Lines.Free;
  End;
End;

Function PlanBodyIntroducesCompletion(Const PreviousBody, NextBody: String): Boolean;
Var
  Previous, Next: TStringList;
  Index: Integer;
Begin
  Result := False;
  If Not TextIsAssistantPlan(NextBody) Then Exit;
  Previous := TStringList.Create;
  Next := TStringList.Create;
  Try
    CollectCompleteKeys(PreviousBody, Previous);
    CollectCompleteKeys(NextBody, Next);
    For Index := 0 To Next.Count - 1 Do
      If Previous.IndexOf(Next[Index]) < 0 Then
        Exit(True);
  Finally
    Next.Free;
    Previous.Free;
  End;
End;

Function PlanCompletionBlocked(Const PreviousBody, NextBody: String; Out ErrorText: String): Boolean;
Begin
  Result := False;
  ErrorText := '';
  If Not PlanBodyIntroducesCompletion(PreviousBody, NextBody) Then Exit;
  If Not WorkingRootHasGitRepository(PlanProjectRoot) Then Exit;
  If AssistantGitTurnCommitted Then Exit;
  ErrorText := 'This working root is a Git repository, so Status cannot become complete until run_git commit succeeds ' +
    'in this turn. Commit the finished work first, then set Status to complete, then commit the plan file. ' +
    'A project with no Git repository can be marked complete with no commit.';
  Result := True;
End;

Procedure NotePlanCompletionWrite(Const Path, PreviousBody: String; Existed: Boolean);
Begin
  If CompletionPath <> '' Then Exit;
  If Not WorkingRootHasGitRepository(PlanProjectRoot) Then Exit;
  CompletionPath := Path;
  CompletionPrevious := PreviousBody;
  CompletionExisted := Existed;
End;

Procedure ResetAssistantPlanTurn;
Begin
  CompletionPath := '';
  CompletionPrevious := '';
  CompletionExisted := False;
End;

Function GitArgsJson(Const Args: Array Of String): String;
Var
  Obj: TJSONObject;
  Arr: TJSONArray;
  Index: Integer;
Begin
  Obj := TJSONObject.Create;
  Arr := TJSONArray.Create;
  For Index := 0 To High(Args) Do
    Arr.Add(Args[Index]);
  Obj.Add('arguments', Arr);
  Result := Obj.AsJSON;
  Obj.Free;
End;

Function GitReplyOutput(Const Reply: String): String;
Var
  Data: TJSONData;
Begin
  Result := '';
  Data := Nil;
  Try
    Data := GetJSON(Reply);
    If Data Is TJSONObject Then
      Result := TJSONObject(Data).Get('output', '');
  Except
    Result := '';
  End;
  Data.Free;
End;

Function PlanPorcelainDirty(Const Output: String): Boolean;
Var
  Lines: TStringList;
  Index: Integer;
  Line: String;
Begin
  Result := False;
  Lines := TStringList.Create;
  Try
    Lines.Text := Output;
    For Index := 0 To Lines.Count - 1 Do
      Begin
        Line := Trim(Lines[Index]);
        If (Line = '') Or (Copy(Line, 1, 5) = 'hint:') Then
          Continue;
        Result := True;
        Exit;
      End;
  Finally
    Lines.Free;
  End;
End;

Function ShortHash(Const Output: String): String;
Var
  Lines: TStringList;
  Index, CharIndex: Integer;
  Line: String;
  Hex: Boolean;
Begin
  Result := '';
  Lines := TStringList.Create;
  Try
    Lines.Text := Output;
    For Index := 0 To Lines.Count - 1 Do
      Begin
        Line := Trim(Lines[Index]);
        If (Line = '') Or (Copy(Line, 1, 5) = 'hint:') Then
          Continue;
        If (Length(Line) < 7) Or (Length(Line) > 40) Then
          Exit;
        Hex := True;
        For CharIndex := 1 To Length(Line) Do
          If Not (Line[CharIndex] In ['0'..'9', 'a'..'f', 'A'..'F']) Then
            Hex := False;
        If Hex Then
          Result := Line;
        Exit;
      End;
  Finally
    Lines.Free;
  End;
End;

Function PlanRelativeIsSafe(Const RelativePath: String): Boolean;
Begin
  Result := (RelativePath <> '') And (RelativePath[1] <> '/') And (RelativePath[1] <> '\') And
    (Pos('..', RelativePath) = 0) And (Pos(#0, RelativePath) = 0);
End;

Function LoadTextFile(Const Path: String; Out Body: String): Boolean;
Var
  Lines: TStringList;
Begin
  Result := False;
  Body := '';
  Lines := TStringList.Create;
  Try
    Try
      Lines.LoadFromFile(Path);
      Body := Lines.Text;
      Result := True;
    Except
      Result := False;
    End;
  Finally
    Lines.Free;
  End;
End;

Function PlanFilePorcelain(Const Root, RelativePath: String; Out Dirty: Boolean; Out ErrorText: String): Boolean;
Var
  Reply: String;
Begin
  Dirty := True;
  ErrorText := '';
  Result := RunAssistantGit(Root, GitArgsJson(['status', '--porcelain', '--', RelativePath]), Reply, ErrorText);
  If Result Then
    Dirty := PlanPorcelainDirty(GitReplyOutput(Reply));
End;

Function UnstagePlanPath(Const Root, RelativePath: String): Boolean;
Var
  Git: TProcess;
Begin
  Result := False;
  If (Root = '') Or Not PlanRelativeIsSafe(RelativePath) Then
    Exit;
  Git := TProcess.Create(Nil);
  Try
    Git.Executable := 'git';
    Git.CurrentDirectory := Root;
    Git.Options := [poWaitOnExit, poNoConsole];
    Git.Parameters.Add('--no-pager');
    Git.Parameters.Add('reset');
    Git.Parameters.Add('-q');
    Git.Parameters.Add('HEAD');
    Git.Parameters.Add('--');
    Git.Parameters.Add(RelativePath);
    Git.Execute;
    Result := Git.ExitCode = 0;
  Finally
    Git.Free;
  End;
End;

Function RestoreNotedPlanCompletion(Const Root, RelativePath: String): String;
Var
  Lines: TStringList;
Begin
  If FileIsSymlink(CompletionPath) Then
    Begin
      Result := 'The plan ' + RelativePath + ' is a symbolic link, so the completion was left in place.';
      Exit;
    End;
  If Not CompletionExisted Then
    Begin
      If Not DeleteFileUTF8(CompletionPath) Then
        Result := 'The new plan ' + RelativePath + ' could not be committed, and it could not be removed.'
      Else
        Result := 'Removed ' + RelativePath + ' because the plan commit failed.';
    End
  Else
    Begin
      Lines := TStringList.Create;
      Try
        Try
          Lines.Text := CompletionPrevious;
          Lines.LineBreak := DetectFileEol(CompletionPrevious);
          Lines.SaveToFile(CompletionPath);
          PublishPlanFileWrite(CompletionPath, CompletionPrevious, False);
          Result := 'The plan status was put back because the plan commit failed. ' +
            'Commit the finished work, set Status to complete, then commit the plan file.';
        Except
          On E: Exception Do
            Result := 'The plan commit failed, and restoring ' + RelativePath + ' failed. ' + E.Message;
        End;
      Finally
        Lines.Free;
      End;
    End;
  If Not PlanRelativeIsSafe(RelativePath) Then
    Result := Result + ' The index was left unchanged because the plan path is not a project-relative file.'
  Else If Not UnstagePlanPath(Root, RelativePath) Then
    Result := Result + ' The index for that file could not be restored.';
End;

Procedure PlanCompletionCommitText(Const PreviousBody, CurrentBody: String; Out Subject, Detail: String);
Var
  PreviousKeys, NextKeys: TStringList;
  Index, SplitAt, Added: Integer;
  Key, Title, Listed: String;
Begin
  Subject := 'Plan: record the completed item';
  Detail := 'The work was committed earlier in this turn. This commit records Status: complete.';
  PreviousKeys := TStringList.Create;
  NextKeys := TStringList.Create;
  Try
    CollectCompleteKeys(PreviousBody, PreviousKeys);
    CollectCompleteKeys(CurrentBody, NextKeys);
    Listed := '';
    Added := 0;
    Title := '';
    For Index := 0 To NextKeys.Count - 1 Do
      If PreviousKeys.IndexOf(NextKeys[Index]) < 0 Then
        Begin
          Key := NextKeys[Index];
          SplitAt := Pos(#1, Key);
          If SplitAt > 0 Then
            Title := Copy(Key, SplitAt + 1, MaxInt)
          Else
            Title := Key;
          If Title = '' Then
            Title := 'the finished item';
          Inc(Added);
          If Listed <> '' Then
            Listed := Listed + ', ';
          Listed := Listed + Title;
        End;
    If Added = 1 Then
      Subject := 'Plan: mark ' + Title + ' complete'
    Else If Added > 1 Then
      Subject := 'Plan: mark completed items';
    If Length(Subject) > 120 Then
      Subject := Copy(Subject, 1, 117) + '...';
    If Listed <> '' Then
      Detail := 'The work was committed earlier in this turn. This commit records Status: complete for ' + Listed + '.';
  Finally
    NextKeys.Free;
    PreviousKeys.Free;
  End;
End;

Function CommitNotedPlanFile(Const Root, RelativePath, CurrentBody: String): String;
Var
  Reply, Err, Subject, Detail, Hash: String;
  Dirty: Boolean;
Begin
  If Not RunAssistantGit(Root, GitArgsJson(['add', '--', RelativePath]), Reply, Err) Then
    Begin
      Result := RestoreNotedPlanCompletion(Root, RelativePath) + ' Staging the plan file failed. ' + Err;
      Exit;
    End;
  PlanCompletionCommitText(CompletionPrevious, CurrentBody, Subject, Detail);
  If Not RunAssistantGit(Root,
    GitArgsJson(['commit', '-m', Subject, '-m', Detail, '--', RelativePath]), Reply, Err) Then
    Begin
      If PlanFilePorcelain(Root, RelativePath, Dirty, Reply) And (Not Dirty) Then
        Begin
          Result := '';
          Exit;
        End;
      Result := RestoreNotedPlanCompletion(Root, RelativePath) + ' The plan commit failed. ' + Err;
      Exit;
    End;
  Hash := '';
  If RunAssistantGit(Root, GitArgsJson(['log', '-1', '--format=%h', '--', RelativePath]), Reply, Err) Then
    Hash := ShortHash(GitReplyOutput(Reply));
  If Hash <> '' Then
    Result := 'Committed ' + RelativePath + ' as ' + Hash + ' so the completion is in history.'
  Else
    Result := 'Committed ' + RelativePath + ' so the completion is in history.';
End;

Function RevertUncommittedPlanCompletion(Out Note: String): Boolean;
Var
  Root, RelativePath, CurrentBody, GitError: String;
  Dirty: Boolean;
Begin
  Result := False;
  Note := '';
  If CompletionPath = '' Then Exit;
  Root := PlanProjectRoot;
  If Not WorkingRootHasGitRepository(Root) Then
    Begin
      ResetAssistantPlanTurn;
      Exit;
    End;
  RelativePath := ProjectRelativePath(CompletionPath);
  If FileIsSymlink(CompletionPath) Then
    Begin
      Note := 'The plan ' + RelativePath + ' is a symbolic link, so the completion was left in place and not committed.';
      Result := True;
      ResetAssistantPlanTurn;
      Exit;
    End;
  If Not FileExistsUTF8(CompletionPath) Or Not LoadTextFile(CompletionPath, CurrentBody) Then
    Begin
      Note := 'Could not read ' + RelativePath + ' to commit the completion.';
      Result := True;
      ResetAssistantPlanTurn;
      Exit;
    End;
  If Not PlanBodyIntroducesCompletion(CompletionPrevious, CurrentBody) Then
    Begin
      ResetAssistantPlanTurn;
      Exit;
    End;
  If Not PlanFilePorcelain(Root, RelativePath, Dirty, GitError) Then
    Begin
      Note := 'Could not check whether the plan file was committed. ' + GitError;
      Result := True;
      ResetAssistantPlanTurn;
      Exit;
    End;
  If Not Dirty Then
    Begin
      ResetAssistantPlanTurn;
      Exit;
    End;
  If Not AssistantGitTurnCommitted Then
    Begin
      Note := RestoreNotedPlanCompletion(Root, RelativePath);
      Result := Note <> '';
      ResetAssistantPlanTurn;
      Exit;
    End;
  Note := CommitNotedPlanFile(Root, RelativePath, CurrentBody);
  Result := Note <> '';
  ResetAssistantPlanTurn;
End;

Function AssistantTurnSettlementNote(Const UserText: String; PlanWasWritten: Boolean): String;
Var
  Low: String;
  AskedCommit, AskedStatus: Boolean;
Begin
  Result := '';
  If Pos('Work on this plan item', UserText) = 1 Then Exit;
  Low := LowerCase(UserText);
  AskedCommit := Pos('commit', Low) > 0;
  AskedStatus := ((Pos('status', Low) > 0) Or (Pos('mark', Low) > 0) Or (Pos('flag', Low) > 0)) And
    ((Pos('complete', Low) > 0) Or (Pos('done', Low) > 0));
  If AskedCommit And WorkingRootHasGitRepository(PlanProjectRoot) And (Not AssistantGitTurnCommitted) Then
    Result := 'No Git commit succeeded in this turn. The repository does not contain this reply''s work.';
  If AskedStatus And (Not PlanWasWritten) Then
    Begin
      If Result <> '' Then
        Result := Result + ' ';
      Result := Result + 'The plan status was not written in this turn.';
    End;
End;

Function StatusFollowsHeading(SL: TStringList; HeadingIndex: Integer; Out StatusText: String;
  Out StatusLine: Integer): Boolean;
Var
  J, Level: Integer;
  Ignored: String;
Begin
  Result := False;
  StatusText := '';
  StatusLine := -1;
  J := HeadingIndex + 1;
  While J < SL.Count Do
    Begin
      Level := PlanHeadingLevel(SL[J], Ignored);
      If Level In [1, 2, 3] Then
        Exit;
      If Trim(SL[J]) = '' Then
        Begin
          Inc(J);
          Continue;
        End;
      If ParseStatusLine(SL[J], StatusText) Then
        Begin
          StatusLine := J;
          Result := True;
        End;
      Exit;
    End;
End;

Procedure ClosePlanSectionBody(Section: TPlanSection; NextHeadingLine: Integer);
Begin
  If Not Assigned(Section) Or (Section.BodyLastLine >= 0) Then
    Exit;
  Section.BodyLastLine := NextHeadingLine - 1;
  If Section.BodyLastLine < Section.HeadingLineIndex Then
    Section.BodyLastLine := Section.HeadingLineIndex;
End;

Procedure InitPlanSection(Section: TPlanSection; Const Title: String; Level, HeadingLine: Integer);
Begin
  Section.Title := Title;
  Section.HeadingLevel := Level;
  Section.HeadingLineIndex := HeadingLine;
  Section.StatusLineIndex := -1;
  Section.Status := pssUnknown;
  Section.StatusText := '';
  Section.Actionable := False;
  Section.BodyLastLine := -1;
  Section.ParentTitle := '';
End;

Function ScanPlanSections(Const RelativeOrAbsolute: String; Sections: TObjectList;
  Out ErrorText: String): Boolean;
Var
  Resolved: String;
  SL: TStringList;
  I, Level, StatusLine: Integer;
  Title, StatusText, ParentTitle: String;
  Section, OpenSection: TPlanSection;
Begin
  Result := False;
  ErrorText := '';
  If Not Assigned(Sections) Then
    Begin
      ErrorText := 'Sections list is nil.';
      Exit;
    End;
  Sections.Clear;
  If Not ResolvePlanPath(RelativeOrAbsolute, Resolved, ErrorText) Then
    Exit;
  If Not FileExistsUTF8(Resolved) Then
    Begin
      ErrorText := 'Plan file not found: ' + Resolved;
      Exit;
    End;
  SL := TStringList.Create;
  Try
    Try
      SL.LoadFromFile(Resolved);
    Except
      On E: Exception Do
        Begin
          ErrorText := E.Message;
          Exit;
        End;
    End;
    OpenSection := Nil;
    ParentTitle := '';
    I := 0;
    While I < SL.Count Do
      Begin
        Level := PlanHeadingLevel(SL[I], Title);
        If Level In [1, 2, 3] Then
          Begin
            ClosePlanSectionBody(OpenSection, I);
            If Level = 2 Then
              Begin
                Section := TPlanSection.Create;
                InitPlanSection(Section, Title, 2, I);
                ParentTitle := Title;
                Sections.Add(Section);
                OpenSection := Section;
              End
            Else If (Level = 3) And StatusFollowsHeading(SL, I, StatusText, StatusLine) Then
              Begin
                Section := TPlanSection.Create;
                InitPlanSection(Section, Title, 3, I);
                Section.Actionable := True;
                Section.ParentTitle := ParentTitle;
                Section.StatusLineIndex := StatusLine;
                Section.StatusText := StatusText;
                Section.Status := StrToPlanSectionStatus(StatusText);
                Sections.Add(Section);
                OpenSection := Section;
              End
            Else
              Begin
                If Level = 1 Then
                  ParentTitle := '';
                OpenSection := Nil;
              End;
          End;
        Inc(I);
      End;
    If Assigned(OpenSection) Then
      ClosePlanSectionBody(OpenSection, SL.Count);
    Result := True;
    WorkflowLogger.Info('AssistantPlan',
      Format('Scanned %d plan section(s) from %s', [Sections.Count, Resolved]));
  Finally
    SL.Free;
  End;
End;

Function SetPlanSectionStatus(Const RelativeOrAbsolute: String; SectionIndex: Integer;
  NewStatus: TPlanSectionStatus; Out ErrorText: String): Boolean;
Var
  Resolved: String;
  Sections: TObjectList;
  Section: TPlanSection;
  SL: TStringList;
  StatusLine: String;
Begin
  Result := False;
  ErrorText := '';
  If NewStatus = pssUnknown Then
    Begin
      ErrorText := 'Cannot set status to unknown.';
      Exit;
    End;
  If Not ResolvePlanPath(RelativeOrAbsolute, Resolved, ErrorText) Then
    Exit;
  Sections := TObjectList.Create(True);
  Try
    If Not ScanPlanSections(Resolved, Sections, ErrorText) Then
      Exit;
    If (SectionIndex < 0) Or (SectionIndex >= Sections.Count) Then
      Begin
        ErrorText := 'Section index out of range.';
        Exit;
      End;
    Section := TPlanSection(Sections[SectionIndex]);
    If Not Section.Actionable Then
      Begin
        ErrorText := 'Status belongs on a ### item, not a section heading.';
        Exit;
      End;
    StatusLine := 'Status: ' + PlanSectionStatusToStr(NewStatus);
    SL := TStringList.Create;
    Try
      Try
        SL.LoadFromFile(Resolved);
        If Section.StatusLineIndex >= 0 Then
          Begin
            If Section.StatusLineIndex >= SL.Count Then
              Begin
                ErrorText := 'Status line index invalid after load.';
                Exit;
              End;
            SL[Section.StatusLineIndex] := StatusLine;
          End
        Else
          Begin
            { Insert blank line + Status: immediately under the heading. }
            If Section.HeadingLineIndex >= SL.Count Then
              Begin
                ErrorText := 'Heading line index invalid after load.';
                Exit;
              End;
            If (Section.HeadingLineIndex + 1 < SL.Count) And
              (Trim(SL[Section.HeadingLineIndex + 1]) = '') Then
              SL.Insert(Section.HeadingLineIndex + 2, StatusLine)
            Else
              Begin
                SL.Insert(Section.HeadingLineIndex + 1, '');
                SL.Insert(Section.HeadingLineIndex + 2, StatusLine);
              End;
          End;
        SL.LineBreak := PlanFileLineBreak(Resolved);
        SL.SaveToFile(Resolved);
        Result := True;
        WorkflowLogger.Info('AssistantPlan',
          Format('Set section "%s" to %s in %s',
            [Section.Title, PlanSectionStatusToStr(NewStatus), Resolved]));
        PublishPlanFileWrite(Resolved, SL.Text, False);
      Except
        On E: Exception Do
          ErrorText := E.Message;
      End;
    Finally
      SL.Free;
    End;
  Finally
    Sections.Free;
  End;
End;

Function GetPlanSectionBody(Const RelativeOrAbsolute: String; SectionIndex: Integer;
  Out BodyText: String; Out ErrorText: String): Boolean;
Var
  Resolved: String;
  Sections: TObjectList;
  Section: TPlanSection;
  SL: TStringList;
  FirstLine, LastLine, I: Integer;
Begin
  Result := False;
  BodyText := '';
  ErrorText := '';
  If Not ResolvePlanPath(RelativeOrAbsolute, Resolved, ErrorText) Then
    Exit;
  Sections := TObjectList.Create(True);
  Try
    If Not ScanPlanSections(Resolved, Sections, ErrorText) Then
      Exit;
    If (SectionIndex < 0) Or (SectionIndex >= Sections.Count) Then
      Begin
        ErrorText := 'Section index out of range.';
        Exit;
      End;
    Section := TPlanSection(Sections[SectionIndex]);
    FirstLine := Section.HeadingLineIndex;
    LastLine := Section.BodyLastLine;
    If LastLine < FirstLine Then
      LastLine := High(Integer);
    SL := TStringList.Create;
    Try
      Try
        SL.LoadFromFile(Resolved);
        If FirstLine >= SL.Count Then
          Begin
            ErrorText := 'Heading line out of range.';
            Exit;
          End;
        If LastLine >= SL.Count Then
          LastLine := SL.Count - 1;
        BodyText := '';
        For I := FirstLine To LastLine Do
          Begin
            If BodyText <> '' Then
              BodyText := BodyText + LineEnding;
            BodyText := BodyText + SL[I];
          End;
        While (Length(BodyText) > 0) And
          ((BodyText[Length(BodyText)] = #10) Or (BodyText[Length(BodyText)] = #13)) Do
          SetLength(BodyText, Length(BodyText) - 1);
        Result := Trim(BodyText) <> '';
        If Not Result Then
          ErrorText := 'Section body is empty.';
      Except
        On E: Exception Do
          ErrorText := E.Message;
      End;
    Finally
      SL.Free;
    End;
  Finally
    Sections.Free;
  End;
End;

End.
