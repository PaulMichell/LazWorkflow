Unit AssistantPlan;

{ Plan-mode paths, Documents/ workspace, and plan Markdown helpers (c) 2026 Michell Computing. }

{$IFDEF FPC}
  {$MODE ObjFPC}
  {$LONGSTRINGS ON}
{$ENDIF}

Interface

Uses
  Classes, SysUtils, Contnrs;

Const
  AssistantDocumentsDirName = 'Documents';
  AssistantDefaultPlanFileName = 'Plan.md';
  AssistantPlanStatusNotStarted = 'not started';
  AssistantPlanStatusInProgress = 'in progress';
  AssistantPlanStatusComplete = 'complete';
  { Canonical identity line. The reader also accepts the same text without the period. }
  AssistantPlanGeneratedLine = 'Generated by Lazarus Project Assistant.';
  AssistantPlanIdentityMaxBytes = 8192;
  AssistantPlanIdentityMaxLines = 32;

Type
  TPlanSectionStatus = (pssUnknown, pssNotStarted, pssInProgress, pssComplete);

  { One progress row: a ## context heading, or a ### item with a Status line. }
  TPlanSection = Class
  Public
    Title: String;
    Status: TPlanSectionStatus;
    StatusText: String;
    HeadingLineIndex: Integer; { 0-based line of the heading }
    StatusLineIndex: Integer; { 0-based line of Status:; -1 if missing }
    HeadingLevel: Integer; { 2 = context, 3 = actionable item }
    Actionable: Boolean; { True only for a ### whose next non-empty line is Status: }
    BodyLastLine: Integer; { Inclusive end; stops before the next level 1–3 heading }
    ParentTitle: String; { Enclosing ## title for an actionable item }
  End;

