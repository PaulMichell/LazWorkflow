        'Ask before file changes and builds'
        'Auto: allow project tools'
        'Always: allow registered tools'
      )
      Style = csDropDownList
      TabOrder = 0
    end
    object PermissionNoteLabel: TLabel
      Left = 12
      Height = 48
      Top = 60
      Width = 620
      AutoSize = False
      Caption = 'Ask is read-only; Plan can write Markdown. Auto and Always currently allow the same bounded Lazarus tools.'
      ParentColor = False
      WordWrap = True
    end
  end
  object ModelGroup: TGroupBox
