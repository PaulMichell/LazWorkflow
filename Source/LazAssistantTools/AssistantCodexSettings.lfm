    object ApprovalLabel: TLabel
      Left = 12
      Height = 17
      Top = 4
      Width = 140
      Caption = 'Tool usage permissions'
      ParentColor = False
    end
    object ApprovalCombo: TComboBox
      Left = 12
      Height = 28
      Top = 24
      Width = 420
      ItemHeight = 0
      ItemIndex = 0
