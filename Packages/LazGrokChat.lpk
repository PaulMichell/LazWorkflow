<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="/"/>
    <Name Value="LazGrokChat"/>
    <Type Value="RunAndDesignTime"/>
    <Author Value="Michell Computing"/>
    <CompilerOptions>
