<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="6">
    <Name Value="LazRepositoryTools"/>
    <Type Value="RunAndDesignTime"/>
    <Author Value="Michell Computing"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <IncludeFiles Value="../Source/LazRepositoryTools"/>
        <OtherUnitFiles Value="../Source/LazRepositoryTools"/>
        <UnitOutputDirectory Value="../Lib/$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
      <CodeGeneration>
        <SmartLinkUnit Value="True"/>
      </CodeGeneration>
    </CompilerOptions>
    <Description Value="Git lifecycle UI and high-quality commit history graph for Lazarus IDE"/>
    <License Value="LGPL-2.1-or-later with static linking exception"/>
    <Version Minor="1"/>
    <Files>
      <Item>
        <Filename Value="../Source/LazRepositoryTools/RegLazRepositoryTools.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="RegLazRepositoryTools"/>
      </Item>
      <Item>
        <Filename Value="../Source/LazRepositoryTools/RepositoryManagerMain.pas"/>
        <UnitName Value="RepositoryManagerMain"/>
      </Item>
      <Item>
        <Filename Value="../Source/LazRepositoryTools/ManageRepositoryForm.pas"/>
        <FileType Value="MainUnit"/>
        <UnitName Value="ManageRepositoryForm"/>
      </Item>
      <Item>
        <Filename Value="../Source/LazRepositoryTools/ManageRepositoryForm.lfm"/>
        <FileType Value="FormResource"/>
      </Item>
      <Item>
        <Filename Value="../Source/LazRepositoryTools/GitService.pas"/>
        <UnitName Value="GitService"/>
      </Item>
      <Item>
        <Filename Value="../Source/LazRepositoryTools/GitGraphModel.pas"/>
        <UnitName Value="GitGraphModel"/>
      </Item>
      <Item>
        <Filename Value="../Source/LazRepositoryTools/GitConfig.pas"/>
        <UnitName Value="GitConfig"/>
      </Item>
      <Item>
        <Filename Value="../Source/LazRepositoryTools/GitSettingsForm.pas"/>
        <UnitName Value="GitSettingsForm"/>
      </Item>
      <Item>
        <Filename Value="../Source/LazRepositoryTools/GitSettingsForm.lfm"/>
        <UnitName Value="GitSettingsForm"/>
      </Item>
      <Item>
        <Filename Value="../Source/LazRepositoryTools/GitDiffView.pas"/>
        <UnitName Value="GitDiffView"/>
      </Item>
      <Item>
        <Filename Value="../Source/LazRepositoryTools/GitDiffView.lfm"/>
        <UnitName Value="GitDiffView"/>
      </Item>
      <Item>
        <Filename Value="../Source/LazRepositoryTools/GitInitForm.pas"/>
        <UnitName Value="GitInitForm"/>
      </Item>
      <Item>
        <Filename Value="../Source/LazRepositoryTools/GitInitForm.lfm"/>
        <UnitName Value="GitInitForm"/>
      </Item>
      <Item>
        <Filename Value="../Source/LazRepositoryTools/GitCloneForm.pas"/>
        <UnitName Value="GitCloneForm"/>
      </Item>
      <Item>
        <Filename Value="../Source/LazRepositoryTools/GitCloneForm.lfm"/>
        <UnitName Value="GitCloneForm"/>
      </Item>
      <Item>
        <Filename Value="../Source/LazRepositoryTools/GitRemotesForm.pas"/>
        <UnitName Value="GitRemotesForm"/>
      </Item>
      <Item>
        <Filename Value="../Source/LazRepositoryTools/GitRemotesForm.lfm"/>
        <UnitName Value="GitRemotesForm"/>
      </Item>
      <Item>
        <Filename Value="../Source/LazRepositoryTools/GitIgnoreForm.pas"/>
        <UnitName Value="GitIgnoreForm"/>
      </Item>
      <Item>
        <Filename Value="../Source/LazRepositoryTools/GitIgnoreForm.lfm"/>
        <UnitName Value="GitIgnoreForm"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item>
        <PackageName Value="SynEditDsgn"/>
      </Item>
      <Item>
        <PackageName Value="LazWorkflowCommon"/>
      </Item>
      <Item>
        <PackageName Value="SynEdit"/>
      </Item>
      <Item>
        <PackageName Value="IDEIntf"/>
      </Item>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
  </Package>
</CONFIG>
