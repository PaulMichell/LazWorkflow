<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="/"/>
    <Name Value="LazGitManager"/>
    <Type Value="RunAndDesignTime"/>
    <Author Value="Michell Computing"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <OtherUnitFiles Value="../Source/LazGitManager;../Source/LazWorkflowCommon"/>
        <UnitOutputDirectory Value="../Lib/$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
      <CodeGeneration>
        <SmartLinkUnit Value="True"/>
      </CodeGeneration>
    </CompilerOptions>
    <Description Value="Git lifecycle UI and high-quality commit history graph for Lazarus IDE"/>
    <License Value="LGPL-2.1-or-later with static linking exception"/>
    <Version Major="0" Minor="1" Release="0" Build="0"/>
    <Files Count="5">
      <Item1>
        <Filename Value="../Source/LazGitManager/RegLazGitManager.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="RegLazGitManager"/>
      </Item1>
      <Item2>
        <Filename Value="../Source/LazGitManager/GitManagerMain.pas"/>
        <UnitName Value="GitManagerMain"/>
      </Item2>
      <Item3>
        <Filename Value="../Source/LazGitManager/GitGraphForm.pas"/>
        <FileType Value="MainUnit"/>
        <UnitName Value="GitGraphForm"/>
      </Item3>
      <Item4>
        <Filename Value="../Source/LazGitManager/GitGraphForm.lfm"/>
        <FileType Value="FormResource"/>
      </Item4>
      <Item5>
        <Filename Value="../Source/LazGitManager/GitService.pas"/>
        <UnitName Value="GitService"/>
      </Item5>
    </Files>
    <RequiredPkgs Count="3">
      <Item1>
        <PackageName Value="LazWorkflowCommon"/>
      </Item1>
      <Item2>
        <PackageName Value="IDEIntf"/>
      </Item2>
      <Item3>
        <PackageName Value="LCL"/>
      </Item3>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
  </Package>
</CONFIG>
