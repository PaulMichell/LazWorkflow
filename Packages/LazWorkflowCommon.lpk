<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="/"/>
    <Name Value="LazWorkflowCommon"/>
    <Type Value="RunAndDesignTime"/>
    <Author Value="Michell Computing"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <OtherUnitFiles Value="../Source/LazWorkflowCommon"/>
        <UnitOutputDirectory Value="../Lib/$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
      <CodeGeneration>
        <SmartLinkUnit Value="True"/>
      </CodeGeneration>
    </CompilerOptions>
    <Description Value="Shared foundation (event bus, logging, UI helpers) for LazRepositoryTools and LazAssistantTools"/>
    <License Value="LGPL-2.1-or-later with static linking exception"/>
    <Version Major="0" Minor="1" Release="0" Build="0"/>
    <Files Count="4">
      <Item1>
        <Filename Value="../Source/LazWorkflowCommon/WorkflowEvents.pas"/>
        <UnitName Value="WorkflowEvents"/>
      </Item1>
      <Item2>
        <Filename Value="../Source/LazWorkflowCommon/WorkflowLog.pas"/>
        <UnitName Value="WorkflowLog"/>
      </Item2>
      <Item3>
        <Filename Value="../Source/LazWorkflowCommon/StatusFooterFrame.pas"/>
        <FileType Value="MainUnit"/>
        <UnitName Value="StatusFooterFrame"/>
      </Item3>
      <Item4>
        <Filename Value="../Source/LazWorkflowCommon/StatusFooterFrame.lfm"/>
        <FileType Value="FormResource"/>
      </Item4>
    </Files>
    <RequiredPkgs Count="2">
      <Item1>
        <PackageName Value="IDEIntf"/>
      </Item1>
      <Item2>
        <PackageName Value="LCL"/>
      </Item2>
    </RequiredPkgs>
    <UsageOptions>
